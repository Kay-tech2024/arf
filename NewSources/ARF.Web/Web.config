  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <sessionState regenerateExpiredSessionId="false" cookieless="UseCookies" cookieName="id" timeout="60" />
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.6" />
    <httpRuntime targetFramework="4.6" maxRequestLength="10002400" executionTimeout="9600" enableVersionHeader="false" />
    <roleManager enabled="false" />
    <machineKey validationKey="59BCCCF4A56E75A4FC5E964411094518A18672F59A73ED12D25F6AE53195223A990C885171876254514A64952ACB62C017ADCAA3ACF62813E2BBC0580F0CBF2E" decryptionKey="166D0D4FC0B11ADAE4F18B48F0D898A3CFDA47C2DAF058F9" validation="SHA1" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <clear />
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <remove name="MiniProfiler" />
      <remove name="MVCGridHandler" />
      <add name="MiniProfiler" path="mini-profiler-resources/*" verb="*" type="System.Web.Routing.UrlRoutingModule" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="MVCGridHandler" verb="*" path="MVCGridHandler.axd" type="MVCGrid.Web.MVCGridHandler, MVCGrid" />
    </handlers>
    <modules>
      <remove name="FormsAuthentication" />
      <remove name="ApplicationInsightsWebTracking" />
      <!--<remove name="DefaultAuthentication" />-->
      <remove name="OutputCache" />
      <remove name="AnonymousIdentification" />
      <remove name="RoleManager" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1073741824" />
        <denyUrlSequences>
          <!--<remove sequence="/Content/files" />
          <add sequence="/Content/files" />-->
        </denyUrlSequences>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom">
      <remove statusCode="403" />
      <error statusCode="403" path="/Errors/Index" responseMode="ExecuteURL" />
      <error statusCode="403" subStatusCode="14" responseMode="ExecuteURL" path="/Errors/Forbidden" />

    </httpErrors>
    <rewrite>
      <rules>
        <remove name="HTTP to HTTPS redirect" />
        <rule name="HTTP to HTTPS redirect" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <remove name="Add Strict-Transport-Security when HTTPS" />
        <rule name="Add Strict-Transport-Security when HTTPS" enabled="false">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" value="max-age=31536000" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
