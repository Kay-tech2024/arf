@{
    ARF.Data.DbModels.ArfDbEntities db = new ARF.Data.DbModels.ArfDbEntities();
    var preferences = CommonManager.GetUserPreferences();
    var isArabic = preferences == null || preferences.Language != LanguagePreference.English;
    ViewBag.FileUploadRequired = true;
}
@model ARF.Web.Models.TermRequestModel

<h3>تقرير المتابعة لمنتصف المدة للمشروع البحثي</h3>
<form action="\Requests\TermFundingRequest" class="form-horizontal maximum-width" type="POST" enctype="multipart/form-data">
    <div class="col-md-4">
        <div class="form-horizontal">
            <div class="form-group text-center">
                <label class="col-sm-12 text-center">مسلسل المشروع:</label>
                <div class="col-sm-12">
                    <input type="text" disabled class="form-control text-center" value="@Model.Id">
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-horizontal">
            <div class="form-group text-center">
                <label class="col-sm-12 text-center">كود الوحدة البحثية:</label>
                <div class="col-sm-12">
                    <input type="text" disabled class="form-control text-center" value="@Model.ResearchUnitCode">
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-horizontal">
            <div class="form-group text-center">
                <label class="col-sm-12 text-center">السنة:</label>
                <div class="col-sm-12">
                    <input type="text" disabled class="form-control text-center" value="@Model.ResearchYear">
                </div>
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                عنوان المشروع باللغة العربية:
            </label>
            <div class="col-md-7">
                <input type="text" disabled class="form-control" value="@Model.TitleArabic">
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                عنوان المشروع باللغة الانجليزية:
            </label>
            <div class="col-md-7">
                <input type="text" disabled class="form-control" value="@Model.TitleEnglish">
            </div>
        </div>
    </div>


    <div class="col-md-6">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-md-5">
                    ميزانية المقترحة:
                </label>
                <input disabled type="text" class="control-label col-md-7" value="@Model.FundingAmount ريال">
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-md-5">
                    المدة المقترحة:
                </label>
                <input disabled type="text" class="control-label col-md-7" value="@Model.FundingDurationMonths شهراً ">
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                نوع مشروع البحث:
            </label>
            <div>
                <label class="radio-inline">
                    <input type="radio" name="optradio">منفرد
                </label>
                <label class="radio-inline">
                    <input type="radio" name="optradio">مشترك
                </label>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="control-label col-md-5">
                    تاريخ التعقد:
                </label>
                <input disabled type="text" class="control-label col-md-7" value="@Model.ContractDate ">
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                كلية  :
            </label>
            <div class="col-md-7">
                <input type="text" disabled class="form-control" value="@Model.ResearchFaculty">
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                الباحث الرئيس  :
            </label>
            <div class="col-md-7">
                <input type="text" disabled class="form-control" value=" @Model.PrimaryResearcherNameArabic">
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5">
                تاريخ التقديم  :
            </label>
            <div class="col-md-7">
                <input type="text" disabled class="form-control" value="@Model.ApplicationDate">
            </div>
        </div>
    </div>

    <div style="margin-top:60px"></div>

    <p>يتم في هذا التقرير بيان ما تم إنجازه من المهام المذكورة في الجدول الزمني لتهفيذ المشروع خلال المدة الزمنية المحددة، بالإضافة إلى النتائج التي عم الحصول عليها،وذلك بشكل مفصل،يشمل مايلي:</p>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-bordered maham">
                <thead>
                    <tr>
                        <th>
                            المهام حسب الجدول الزمني
                        </th>
                        <th>نسبة الإنجاز </th>
                        <th> مسوغات التاخير</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var index = 0;}
                    @foreach (var item in Model.Tasks)
                    {
                        <tr>
                            <td> @*@Html.TextBoxFor(m=>m.Tasks[index].TaskName, new { @class="form-control"})*@ <input class="form-control ltr" id="Tasks_@(index)__TaskName" name="Tasks[@(index)].TaskName" type="text" value="@Model.Tasks[index].TaskName" /></td>
                            <td>@*@Html.TextBoxFor(m => m.Tasks[index].CompletionPercent, new { @class = "form-control" })*@<input class="form-control ltr" id="Tasks_@(index)__CompletionPercent" name="Tasks[@(index)].CompletionPercent" type="text" value="@Model.Tasks[index].CompletionPercent" /></td>
                            <td>@*@Html.TextBoxFor(m => m.Tasks[index].DelayReason, new { @class = "form-control" })*@<input class="form-control ltr" id="Tasks_@(index)__DelayReason" name="Tasks[@(index)].DelayReason" type="text" value="@Model.Tasks[index].DelayReason" /> </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
            <a class="btn btn-success pull-right" id="add-row">اضاف سطر </a>
        </div>

    </div>
    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-sm-8 ">هل يمكن ان ينتج عن ها المشروع براءة اختراع علمي </label>
            <div class="col-md-4">
                <label><input type="radio" class="radio-inline" name="optradio"> نعم </label>
                <label><input type="radio" class="radio-inline" name="optradio">  لا </label>
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-5 ">العقبات التي توجه المشروع إن وجدت،ورأي الباحث الرئيس، حول كيفية التغلب على هذه العقبات </label>
            <div class="col-md-7">
                <textarea rows="5" class="form-control"></textarea>
            </div>
        </div>
    </div>

    <label class="control-label"> المرفقات والشواهد على التقدم في المشروع  </label>

    @{Html.RenderPartial("~/Views/Shared/_FileUpload.cshtml");}

    <div class="col-md-12" style="margin:15px 0; background:rgba(218, 218, 250, 0.88)">

    </div>

    <div class="form-group">
        <label class="control-label col-md-2">توقيع الباحث الرئيسية</label>
        <div class="col-md-4">
            <input class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary start">
        <i class="glyphicon glyphicon-upload"></i>
        <span>Submit</span>
    </button>

</form>

@section scripts{

    <script nonce="@Html.ScriptNonce()">
        var index = 1;
        $('#add-row').click(function () {
            var html = $('table tbody tr').first().html();
            //html = html + '<td><a class="btn btn-xs btn-danger remove-row">حذف</a></td>';
            html = html.replaceAll("value=", "");
            html = html.replaceAll("Tasks_0", "Tasks_" + index);
            html = html.replaceAll("Tasks[0]", "Tasks[" + index + "]");
            index++;
            $('table.maham').find('tbody').append('<tr>' + html + '</tr>');
        });

        $(document).on('click', '.remove-row', function () {
            $(this).parents('tr').remove();
        });

    </script>

}