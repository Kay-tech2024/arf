@model RequestSummaryViewModel2

    @{

        if (Model.SuggestedActivities == null || Model.SuggestedActivities.Count == 0)
        {
            Model.SuggestedActivities = new List<SuggestedActivityViewModel> { new SuggestedActivityViewModel() };
        }

        if (Model.Beneficiaries == null || Model.Beneficiaries.Count == 0)
        {
            Model.Beneficiaries = new List<BeneficiaryViewModel> { new BeneficiaryViewModel() };
        }

        if (Model.PublishContainers == null || Model.PublishContainers.Count == 0)
        {
            Model.PublishContainers = new List<PublishContainerViewModel> { new PublishContainerViewModel() };
        }

    }

    <div>
        <h4 class="title">@LangHelpers.Instance["suggested_activities"]</h4>
    </div>

    <br />

    <div class="panel-group div-repeatable" data-key="SuggestedActivities">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>@LangHelpers.Instance["sn"]</th>
                    <th>@LangHelpers.Instance["activity_name"]</th>
                    <th>@LangHelpers.Instance["activity_type"]</th>
                    <th>@LangHelpers.Instance["activity_address"]</th>
                    <th>@LangHelpers.Instance["activity_description"]</th>
                    <th>    </th>
                </tr>
            </thead>
            @{
                var index = -1;
            }
            <tbody>
                @foreach (var c in Model.SuggestedActivities)
            {
                index++;
                ViewBag.Index = index;

                    @Html.Partial("~/Views/Requests/FundingRequests/_PartialActivityPreview.cshtml", Model);

            }
            </tbody>
        </table>

        @*<a href="#" class="btnAddRow btn btn-success pull-right">@LangHelpers.Instance["add"]</a>*@
        <div class="clearfix"></div>
    </div>



    <div>
        <h4 class="title">@LangHelpers.Instance["beneficiaries"]</h4>
    </div>

    <br />

    <div class="panel-group div-repeatable" data-key="Beneficiaries">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>@LangHelpers.Instance["sn"]</th>
                    <th>@LangHelpers.Instance["beneficiary_name"]</th>
                    <th>@LangHelpers.Instance["beneficiary_address"]</th>
                    <th>@LangHelpers.Instance["benefit_description"]</th>
                    <th>@LangHelpers.Instance["actions"]</th>
                </tr>
            </thead>
            @{
                index = -1;
            }
            <tbody>
                @foreach (var c in Model.Beneficiaries)
            {
                index++;
                ViewBag.Index = index;

                    @Html.Partial("~/Views/Requests/FundingRequests/_PartialBeneficiaryPreview.cshtml", Model);

            }
            </tbody>
        </table>

        @*<a href="#" class="btnAddRow btn btn-success pull-right">@LangHelpers.Instance["add"]</a>*@
        <div class="clearfix"></div>
    </div>



    <div>
        <h4 class="title">@LangHelpers.Instance["publish_containers"]</h4>
    </div>

    <br />

    <div class="panel-group div-repeatable" data-key="PublishContainers">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>@LangHelpers.Instance["sn"]</th>
                    <th>@LangHelpers.Instance["container_name"]</th>
                    <th>@LangHelpers.Instance["container_address"]</th>
                    <th>@LangHelpers.Instance["selection_reason"]</th>
                    <th>@LangHelpers.Instance["actions"]</th>
                </tr>
            </thead>
            @{
                index = -1;
            }
            <tbody>
                @foreach (var c in Model.PublishContainers)
            {
                index++;
                ViewBag.Index = index;

                    @Html.Partial("~/Views/Requests/FundingRequests/_PartialPublishContainerPreview.cshtml", Model);

            }
            </tbody>
        </table>

        @*<a href="#" class="btnAddRow btn btn-success pull-right">@LangHelpers.Instance["add"]</a>*@
        <div class="clearfix"></div>
    </div>


    @{
        ViewBag.Index = 0;
        ViewBag.IsTemplate = true;
    }

