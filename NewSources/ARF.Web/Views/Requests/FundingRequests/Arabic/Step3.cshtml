        @this.ScriptBlock(

                                                            @<script type="text/javascript" nonce="@Html.ScriptNonce()">
     var templates = {};
                                                templates.FundingSources = '@(Html.Raw(Html.Partial("~/Views/Requests/FundingRequests/_PartialFundingSource.cshtml", Model).ToHtmlString().Replace("\r\n", " ")))';
                                                    templates.Keywords = '<td><input name="Keywords[{index}]" type="text" class="form-control" /></td>';
                                                    templates.KeywordsEnglish = '<td><input name="KeywordsEnglish[{index}]" type="text" class="form-control" /></td>';

         $('.btnAddRow').on('click', function (e) {

             var div = $(this).parent();
             var key = div.attr('data-key');
             var elms = div.find('tbody tr');

             var rowHtml = templates[key];


                                                    if (key === 'Keywords' || key === 'KeywordsEnglish') {
                elms = div.find('tbody td');
                var oldIndex = elms.length;

                                                    var $tr = $('<tr>');
                                                    for (var i = 0; i < 6; i++) {
                                                        var index = oldIndex + i;
                                                        var el = $(rowHtml.replaceAll('{index}', index).replaceAll('{order}', index + 1).replaceAll('data-id="0"', 'data-id="' + index + '"').replaceAll('_0__', '_' + index + '__').replaceAll('[0]', '[' + index + ']'));

                                                        $tr.append(el);
                                                    }

                                                    div.find('table tbody').append($tr);



            } else {


                var index = elms.length;

                var el = $(rowHtml.replaceAll('{index}', index).replaceAll('{order}', index + 1).replaceAll('data-id="0"', 'data-id="' + index + '"').replaceAll('_0__', '_' + index + '__').replaceAll('[0]', '[' + index + ']'));
                el.find('input,select,textarea').val('');
                el.find('.field-validation-error').remove();

                div.find('table tbody').append(el);
            }

             e.preventDefault();
             return false;

         });

         onDomInserted('.btnRemoveRow', function (el) {

             $(el).on('click', function (e) {


                 var elm = $(el).closest('tr');
                 var index = parseInt(elm.attr('data-index'));
                 var div = elm.closest('.div-repeatable');
                 var elms = div.find('tbody tr');

                 for (var i = 0; i < elms.length; i++) {

                     if (index == i) {
                         elm.remove();
                     } else if (index < i) {
                         var els = $(elms[i]).find('input,select,textarea');;

                         for (var j = 0; j < els.length; j++) {
                             var el2 = $(els[j]);
                             if (!el2.attr('name')) continue;
                             var tabs = el2.attr('name').split('.');
                             var name = tabs[0].split('[')[0];
                             var x = name + '[' + (i - 1) + '].' + prop;

                             var prop = tabs[1];
                             el2.attr('id', name + (i - 1) + '_' + prop).attr('name', name + '[' + (i - 1) + '].' + prop);
                         }
                         $(elms[i]).attr('data-index', i - 1);
                     }
                 }
                 e.preventDefault();
                 return false;

             });
         });


                                             onDomInserted('.row-section-header', function (el) {

                                                 $(el).find('a').on('click', function (e) {

                                                     var xel = $(el).next('.row-section-details');
                                                     var attr = xel.attr('data-is-visible');

                                                     if (attr === '1') {

                                                         xel.css('display', 'none').attr('data-is-visible', '0');
                                                     } else {
                                                         var others = $('.row-section-details');
                                                         for (var i = 0; i < others.length; i++) {
                                                             $(others[i]).css('display', 'none').attr('data-is-visible', '0');
                                                         }
                                                         xel.css('display', 'table-row').attr('data-is-visible', '1');
                                                     }

                                                     e.preventDefault();
