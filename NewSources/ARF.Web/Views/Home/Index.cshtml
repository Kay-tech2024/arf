<div class="container">
    <div id="filter-panel" class="collapse filter-panel">
        <div class="panel panel-default">
            <div class="panel-body">
                <form class="form" role="form" id="searchform">
                    @if (!Utils.HasRolesAny(ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch))
                    {
                        <div class="row">
                            <div class="form-group col-sm-4">
                                <label class="control-label" for="pref-perpage">@LangHelpers.Instance["fields"]</label>
                                <select id="fieldDropDown" name="field" multiple="multiple" class="form-control" style="width:300px;height:200px" onchange="fieldIsChange()">
                                    <option value="-1">@LangHelpers.Instance["please_select"]</option>
                                </select>
                            </div> <!-- form group [rows] -->
                            <div class="form-group  col-sm-8">
                                <label class="control-label" for="collegeDropDown">@LangHelpers.Instance["college"]</label>
                                <select id="collegeDropDown" name="college" multiple class="form-control" style="width:600px;height:200px">
                                    <option class="defaultvalue" value="-1">@LangHelpers.Instance["please_select"]</option>
                                </select>
                            </div><!-- form group [search] -->
                        </div>
                    }
                    <div class="row">
                        <div class="form-group  col-sm-4">
                            <label class="control-label" for="requestTypeDropDown">@LangHelpers.Instance["request_type"]</label>
                            <select id="requestTypeDropDown" name="requesttype" multiple onchange="requesttypechange()" class="form-control" style="width:300px;height:200px">
                                <option value="-1">@LangHelpers.Instance["please_select"]</option>
                            </select>
                        </div>
                        <div class="form-group  col-sm-8">
                            <label class="control-label" for="statusTypeDropDown">@LangHelpers.Instance["status"]</label>
                            <select id="statusTypeDropDown" name="statustype" multiple class="form-control" style="width:600px;height:200px">
                                <option value="-1">@LangHelpers.Instance["please_select"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-sm-6">
                            <label class="control-label">@LangHelpers.Instance["title"]</label>
                            <input type="text" name="Title" class="form-control input-sm" id="title">
                        </div> <!-- form group [rows] -->
                        <div class="form-group col-lg-6">
                            <label class="control-label">@LangHelpers.Instance["researcher"]</label>
                            <input type="text" name="Researcher" class="form-control input-sm" id="researcher">
                        </div><!-- form group [search] -->
                    </div>
                    <div class="row">
                        <div class="form-group col-sm-6 is-calendarsPicker" data-hirji="1">
                            <label class="control-label">@LangHelpers.Instance["start_date"]</label>
                            <input type="text" name="startdate" class="form-control input-sm defaultPopup" id="startdate">
                        </div> <!-- form group [rows] -->
                        <div class="form-group col-lg-6 is-calendarsPicker" data-hirji="1">
                            <label class="control-label">@LangHelpers.Instance["end_date"]</label>
                            <input type="text" name="enddate" class="form-control input-sm defaultPopup" id="enddate">
                        </div><!-- form group [search] -->
                    </div>
                    <div class="row">
                        <div class="form-group col-lg-6">
                            <input type="button" value="@LangHelpers.Instance["search"]" class="form-group btn btn-info" onclick="search()" />
                        </div>
                        <div class="form-group col-lg-6">
                            <input type="button" value="@LangHelpers.Instance["clear"]" class="form-group btn btn-primary" onclick="clearFilter()" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <button type="button" class="btn btn-primary" data-toggle="collapse" data-target="#filter-panel">
        <span class="glyphicon glyphicon-cog"></span>@LangHelpers.Instance["filter"]
    </button>
</div>
