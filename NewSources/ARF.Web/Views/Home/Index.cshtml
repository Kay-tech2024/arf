<div class="box2 box2-info">

    <ul class="nav nav-tabs nav-tabs-responsive">

        <li><a data-target="#pending" data-toggle="tab"><span class="text">@LangHelpers.Instance["pending"]</span></a></li>

        <li><a data-target="#archive" data-toggle="tab"><span class="text">@LangHelpers.Instance["archive"]</span></a></li>
    </ul>

    <div class="loading" style="display: none;top: 10%;" id="loadingdiv1">@LangHelpers.Instance["wait"]</div>
    <div class="tab-content">

        <div class="tab-pane" id="pending">
            <div class="table-responsive">
                <table id="grdAll" style="width:100%" class="data-table-command table table-striped table-small-font table-vmiddle">
                    <thead>
                        <tr>
                            <th scope="col" data-column-id="updated" data-width="50px" data-visible="false" data-order="desc"></th>
                            <th scope="col" data-column-id="uniqueId" data-identifier="true" data-visible="true">
                                @LangHelpers.Instance["num"]
                            </th>

                            <th scope="col" data-column-id="title">
                                @LangHelpers.Instance["title"]
                            </th>

                            @if (!Utils.IsCollegeUser)
                            {
                                <th style="width: 100%" scope="col" data-column-id="collegeName">
                                    @LangHelpers.Instance["college_name"]
                                </th>
                            }

                            <th scope="col" data-column-id="type">
                                @LangHelpers.Instance["request_type"]
                            </th>

                            <th scope="col" data-column-id="dateUpdated" data-width="100px" data-formatter="datetime">
                                @LangHelpers.Instance["last_updated"]
                            </th>
                            <th scope="col" data-column-id="status" data-formatter="RequestStatus">
                                @LangHelpers.Instance["status"]
                            </th>

                            <th scope="col" data-width="125px" data-column-id="commands" data-formatter="commands" data-sortable="false">@LangHelpers.Instance["actions"]</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <form id="request_delete" method="post" action="@Url.Action("Delete", "Requests")">
            @Html.AntiForgeryToken()
            <input id="RequestId" type="hidden" name="RequestId" value="" />
        </form>

        <div class="tab-pane" id="archive">
            <div class="table-responsive">
                <table id="grdInbox" style="width:100%" class="data-table-command table table-striped table-small-font table-vmiddle">
                    <thead>
                        <tr>
                            <th scope="col" data-column-id="updated" data-width="50px" data-visible="false" data-order="desc"></th>
                            <th scope="col" data-column-id="uniqueId" data-identifier="true" data-visible="true">
                                @LangHelpers.Instance["num"]
                            </th>

                            <th scope="col" data-column-id="title">
                                @LangHelpers.Instance["title"]
                            </th>

                            @if (!Utils.IsCollegeUser)
                            {
                                <th scope="col" data-column-id="collegeName">
                                    @LangHelpers.Instance["college_name"]
                                </th>
                            }

                            <th scope="col" data-column-id="type">
                                @LangHelpers.Instance["request_type"]
                            </th>

                            <th scope="col" data-column-id="dateUpdated" data-width="100px" date-formatter="datetime">
                                @LangHelpers.Instance["last_updated"]
                            </th>
                            <th scope="col" data-column-id="status" data-formatter="RequestStatus">
                                @LangHelpers.Instance["status"]
                            </th>

                            <th scope="col" data-column-id="commands" data-formatter="commands" data-sortable="false">@LangHelpers.Instance["actions"]</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    @section Scripts{
        <script type="text/javascript" nonce="@Html.ScriptNonce()">

            //new code for search
            function clearFilter() {

                $('#fieldDropDown').val("");
                $('#collegeDropDown').val("");
                $('#requestTypeDropDown').val("");
                $('#statusTypeDropDown').val("");
                $('#researcher').val("");
                $('#title').val("");
                $('#startdate').val("");
                $('#enddate').val("");
            };
            function search() {
                var fileds = $('#fieldDropDown').val();
                var colleges = $('#collegeDropDown').val();
                var requesttype = $('#requestTypeDropDown').val();
                var status = $('#statusTypeDropDown').val();
                var researcher = $('#researcher').val();
                var title = $('#title').val();
                var startdate = $('#startdate').val();
                var enddate = $('#enddate').val();
                model = {
                    field: fileds, college: colleges, requesttype: requesttype, statustype: status, startdate: startdate
                    , enddate: enddate, title: title, researcher: researcher
                };
                console.log(model);
                toGrid('#' + $('.tab-pane.active .table').attr('id'));

            };
            function fieldIsChange() {
                $('#collegeDropDown option:not(:first)').remove();
                var fields = $('#fieldDropDown').val();
                $.post(baseAjaxUrl + "GetCollegesByField",{ fieldid:fields}, function (data) {
                    $.each(data, function (i, v) {
                        $.each(v, function (ind,val) {
                            $("#collegeDropDown").append($('<option value='+this.id+'>'+this.value+'</option>'));

                        });

                    });
                });
            };
                function requesttypechange() {
                    $("#statusTypeDropDown  option:not(:first)").remove();
                    $.post(baseAjaxUrl + "GetStatusByRequestId", { RequestId: $('#requestTypeDropDown').val()}, function (data) {
                        $.each(data, function (i, v) {
                            $("#statusTypeDropDown").append($('<option value=' + this.id + '>' + this.value + '</option>'));
                        });
                    });
            };

            $(document).ready(function () {

                $.get(baseAjaxUrl + "GetFields", function (data) {
                    $.each(data, function (i, v) {
                        $("#fieldDropDown").append($("<option/>").val(this.id).text(this.value));
                    });
                });
                $.get(baseAjaxUrl + "GetCollegesByField?fieldid=" + $('#fieldDropDown').val(), function (data) {
                    $.each(data, function (i,v) {
                        $("#collegeDropDown").append($("<option/>").val(this.id).text(this.value));

                    });
                });
                $.get(baseAjaxUrl + "GetRequestType", function (data) {
                    $.each(data, function (i, v) {
                        $("#requestTypeDropDown").append($("<option/>").val(this.id).text(this.value));
                    });
                });
                $.get(baseAjaxUrl + "GetRequestStatus", function (data) {
                    $.each(data, function (i, v) {
                        $("#statusTypeDropDown").append($("<option/>").val(this.id).text(this.value));
                    });
                });
            });
            var type = null;
            var defaultType = 'pending'
            var model = {};
            var url = document.location.toString();
            if (url.match('#') && url.split('#').length > 1) {
                type = url.split('#')[1];
            } else
            {
                type = defaultType;
            }

            var toGrid = function (selector) {

                if (!selector) return;

                if($(selector).hasClass('bootgrid-table'))
                {

                    $(selector).bootgrid('reload');
                    return;
                }


                var grid = $(selector).bootgrid({
                    ajax: true,
                    rowCount: 20,
                    url: function () { return baseAjaxUrl + "ListRequests?status="+type },
                    post: function () {
                        return {filter:model};
                    },
                    ajaxSettings: {
                        method: "POST",
                        cache: false,
                    },
                    searchSettings: {
                        delay: 3000
                    },
                    labels: {
                        all: '@LangHelpers.Instance["all"]',
                        infos: '@LangHelpers.Instance["from"] {{ctx.start}} @LangHelpers.Instance["to"] {{ctx.end}} (@LangHelpers.Instance["total"] {{ctx.total}})',
                        loading: '@LangHelpers.Instance["wait"]',
                        search: '@LangHelpers.Instance["search"]',
                        noResults: "@LangHelpers.Instance["no_results"]"
                    },
                    css: {
                        icon: 'fa icon',
                        iconColumns: 'fa-view-module',
                        iconDown: 'fa-sort-alpha-asc',
                        iconRefresh: 'fa-refresh',
                        iconUp: 'fa-sort-alpha-desc',
                        iconSearch: 'fa-search'
                    },
                    formatters: {
                        "Requestlink": function (column, row) {
                            alert('hi');
                            if(row.jobSeekerName)
                                return '<a href="' + baseUrl + 'Requests/View/' + row.id + '">' + row.name + '</a>';
                            else return '';

                        },
                        "datetime": function (column, row) {
                            var tip = '';
                            if (row.dateUpdatedActual) {
                                tip = row.dateUpdatedActual;
                            }

                            return '<span title="'+tip+'">'+row.dateUpdated+'</span>';

                        },
                        "commands": function (column, row) {
                            var buttonsHtml = '';

                            var isActionable = row.actionable === true;

                                if(isActionable)
								{
									buttonsHtml += '<a href="@Url.Action("View", "Requests")/' + row.id + '" class="btn btn-xs btn-danger command-edit">@ArfStrings.act</a>';

                                }
                            else
                            {
									buttonsHtml += '<a href="@Url.Action("View", "Requests")/' + row.id + '" class="btn btn-xs btn-info command-edit"> @ArfStrings.details</a>';

                            }

                            if (row.allowToDelete) {
                                buttonsHtml += '&nbsp;&nbsp;<a onclick="DeleteConfirmation(' + row.id + ')" class="btn btn-xs btn-danger command-delete">@ArfStrings.delete</a>';
                            }

                            return buttonsHtml;
                        },
                        "phone": function (column, row) {
                            if(row.mobileNumber !== undefined && row.mobileNumber.length >= 8)
                            {
                                if(row.mobileNumber[0] === '5')
                                    row.mobileNumber = "0" + row.mobileNumber;
                                return '<a href="tel:' + row.mobileNumber + '">' + row.mobileNumber + '</a>';
                            } else
                            {
                                return '';
                            }

                        },

                    }
                }).on("loaded.rs.jquery.bootgrid", function () {
                    $('html, body').animate({
                        scrollTop: 0
                    }, 300);
                    var pages = grid.bootgrid('getTotalPageCount');
                    if (pages <= 1) {
                        $(selector).next('.bootgrid-footer').find('.pagination').hide();
                    } else {
                        $(selector).next('.bootgrid-footer').find('.pagination').show();
                    }

                    grid.fadeIn();

                    grid.find(".command-approve, .command-reject").on("click", function (e) {

                        var that = $(this);

                        var id = $(this).data("row-id");

                        swal({
                            title: "Are you sure?",
                            type: "warning",
                            showCancelButton: true,
                            confirmButtonColor: "#DD6B55",
                            confirmButtonText: "Yes!",
                            closeOnConfirm: false,
                            cancelButtonText: 'Cancel'

                        }, function () {
                            var isApproved = that.hasClass('command-approve');

                            if(isApproved)
                            {
                                $.ajax({
                                    url: baseAjaxUrl + "ApproveRequest?cid=" + id,
                                    context: document.body
                                }).done(function () {
                                    swal.close();
                                    grid.bootgrid("reload");
                                });
                            } else
                            {
                                $.ajax({
                                    url: baseAjaxUrl + "RejectRequest?cid=" + id,
                                    context: document.body
                                }).done(function () {
                                    swal.close();
                                    grid.bootgrid("reload");
                                });
                            }
                        });

                    });

                });

                return grid;
            }
            function DeleteConfirmation(requestId) {
                $("#RequestId").val(requestId);

                swal({
                    title: "@LangHelpers.Instance["are_you_sure_delete_request"]",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#DD6B55",
                    confirmButtonText: "@LangHelpers.Instance["yes"]",
                    closeOnConfirm: true,
                    cancelButtonText: '@LangHelpers.Instance["no"]'

                }, function () {
                    $("#RequestId").val(requestId);
                    $("#request_delete").submit();
                 });

                e.preventDefault();
                return false;
            }


            toGrid('#' + $('.tab-pane.active .table').attr('id'));

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).data('target');

                switch (target) {
                    case '#pending':
                        type = 'pending';
                        break;
                    case '#archive':
                        type ='archive';
                        break;

                    default:
                        type =defaultType;
                        break;
                }

                toGrid('#' + $('.tab-pane.active .table').attr('id'));
            });

            var url = document.location.toString();
            if (!url.match('#') || url.split('#').length <= 1 || url.split('#')[1].toLowerCase() == defaultType) {
                type =defaultType;
                $('.nav-tabs a[data-target=\'#'+defaultType+'\']').tab('show');
            }

        </script>
    }
</div>