@{
    Layout = null;
    var key = (string)null;
    var value = (string)null;
    var lang = (string)null;

    if (Request["key"] != null)
    {
        key = Request["key"];
    }

    if (Request["value"] != null)
    {
        value = Request["value"];
    }

    if (Request["lang"] != null)
    {
        lang = Request["lang"];
    }

    if (!string.IsNullOrWhiteSpace(key))
    {
        key = Utils.PascalCaseToUnderscore(key.Trim());
    }

    if (!string.IsNullOrWhiteSpace(value))
    {
        value = value.Trim();
    }

    if (string.IsNullOrWhiteSpace(lang) && lang != "en")
    {
        lang = "ar";
    }



}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>ARF Translation page</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/Content/css/bootstrap-rtl.css">

    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body style="direction: rtl;">

    <div class="container">

        <h3>ترجمة مصطلح</h3>
        <br />

        <div class="row">
            <div class="col-md-12">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-validation">
                        <h5>@LangHelpers.Instance["ValidationSummary"]</h5>
                        <div class="text-left">
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }

                @using (Html.BeginForm("Translate", "Settings", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group required">
                        <label class="control-label col-md-4" for="pwd">المصطلح</label>
                        <div class="col-md-8">
                            <input id="txtKey" name="key" value="@key" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group required">
                        <label class="control-label col-md-4" for="pwd">اللغة</label>
                        <div class="col-md-8">
                            <select id="ddlLang" name="lang" class="form-control">
                                <option value="ar" @(lang == "ar" ? "selected" : "")>العربية</option>
                                <option value="en" @(lang == "en" ? "selected" : "")>الإنجليزية</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group required">
                        <label class="control-label col-md-4" for="pwd">النص</label>
                        <div class="col-md-8">
                            <input id="txtValue" name="value" value="@value" class="form-control" />
                        </div>
                    </div>


                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-8">
                            <button type="submit" class="btn btn-success btn-block">إرسال</button>
                        </div>
                    </div>
                }

            </div>
        </div>



    </div>

    <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js" nonce="@Html.ScriptNonce()"></script>
    <!-- Include all compiled plugins (below), or include individual files as needed -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>



    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        var retreiveTranslation = function () {
            var key = $('#txtKey').val();
            var lang = $('#ddlLang').val();

            if (!key || !lang || key.trim().length === 0 || (lang != "ar" && lang != "en")) return;


            $.getJSON('@Utils.GetApplicationUrl()Settings/getTranslation?key=' + key + "&lang=" + lang, function (res) {
                $('#txtValue').val(res);
            });
        };

        $('#txtKey').on('input', function () {
            retreiveTranslation();
        });

        $('#ddlLang').on('change', function () {
            retreiveTranslation();
        });

    </script>
</body>
</html>