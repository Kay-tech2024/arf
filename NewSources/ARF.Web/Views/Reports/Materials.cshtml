@model List<ARF.Data.DbModels.ViewMaterialRequest>
@{
    ViewBag.Title = "Types";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalapproved = 0;
    var totalsubmitted = 0;
    var totalrejected = 0;
    var totalapprovedmid = 0;
    var totalamount = 0;
    var totalapprovedunpaid = 0;
    var totalpaid = 0;
}


<style>

    @@media print {
        a[href]:after {
            content: none !important;
        }

        #burger {
            display: none !important;
        }

        #menuToggleLang {
            display: none !important;
        }

        #content {
            left: 0px;
        }

        .container {
            width: 100%;
        }

        .alert-info {
            display: none !important;
        }

        .printhide {
            display: none !important;
        }

        .breadcrumb {
            display: none !important;
        }

        .printbtn {
            display: none !important;
        }
    }
</style>


<ul class="breadcrumb printbtn">
    <li>@Html.ActionLink(LangHelpers.Instance["homepage"], "Index", "Home")</li>

    <li>@Html.ActionLink(LangHelpers.Instance["reports"], "Index", "Reports")</li>

    <li>@LangHelpers.Instance["materials_and_equipment_report"]</li>
</ul>

<div class="logo printhide" style="background:grey">
    <img src="/Content/aps/imgs/logo-1.png" class="img-responsive center-block" style="width:300px !important">
</div>

<h3>@LangHelpers.Instance["materials_and_equipment_report"]</h3>
<br />

<div class="container">
    <table class="table table-responsive table-striped table-hover">
        <thead>
            <tr>
                <th>
                    مركز البحوث
                </th>
                <th>
                    عدد الطلبات المقدمة
                </th>
                <th>
                    عدد الطلبات المقبولة
                </th>
                <th>
                    عدد الطلبات المقبولة في انتظار الصرف
                </th>
                <th>
                    عدد الطلبات المرفوضة
                </th>
                <th>
                    عدد الطلبات التي تم صرف مستحقاتها
                </th>
                <th>
                    إجمالي المبلغ المصروف
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                if (item.ApprovedRequests != null)
                {
                    totalapproved += (int)item.ApprovedRequests;
                }
                else
                {
                    totalapproved += 0;
                }

                if (item.SubmittedRequests != null)
                {
                    totalsubmitted += (int)item.SubmittedRequests;
                }
                else
                {
                    totalsubmitted += 0;
                }


                if (item.RejectedRequests != null)
                {
                    totalrejected += (int)item.RejectedRequests;
                }
                else
                {
                    totalrejected += 0;
                }

                if (item.ApprovedUnpaidRequests != null)
                {
                    totalapprovedunpaid += (int)item.ApprovedUnpaidRequests;
                }
                else
                {
                    totalapprovedunpaid += 0;
                }

                if (item.PaidRequests != null)
                {
                    totalpaid += (int)item.PaidRequests;
                }
                else
                {
                    totalpaid += 0;
                }

                if (item.TotalAmount != null)
                {
                    totalamount += (int)item.TotalAmount;
                }
                else
                {
                    totalamount += 0;
                }

                <tr>
                    <td>@item.CollegeNameArabic</td>
                    <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=1&CollegeId=@item.CollegeId">@item.SubmittedRequests</a></td>
                    <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=2&CollegeId=@item.CollegeId">@item.ApprovedRequests</a></td>
                    <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=3&CollegeId=@item.CollegeId">@item.ApprovedUnpaidRequests</a></td>
                    <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=4&CollegeId=@item.CollegeId">@item.RejectedRequests</a></td>
                    <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=5&CollegeId=@item.CollegeId">@item.PaidRequests</a></td>
                    <td>@item.TotalAmount</td>
                </tr>
            }


            <tr class="success">
                <td>@LangHelpers.Instance["totalA"]</td>
                <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=1&CollegeId=0">@totalsubmitted </a></td>
                <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=2&CollegeId=0">@totalapproved</a></td>
                <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=3&CollegeId=0">@totalapprovedunpaid </a></td>
                <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=4&CollegeId=0">@totalrejected </a></td>
                <td><a href="@Utils.GetApplicationUrl()Reports/List?ReportNo=3&RequestStatus=5&CollegeId=0">@totalpaid </a></td>
                <td>@totalamount</td>
            </tr>
        </tbody>

    </table>

    <button class="btn btn-primary printbtn" onclick="window.print();">@LangHelpers.Instance["print"]&nbsp;&nbsp;<i class="fa fa-print"></i></button>
</div>
