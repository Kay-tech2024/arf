@model LoginViewModel
@{

    var isPostBack = HttpContextManager.Current.Request.HttpMethod == "POST";
    var preferences = CommonManager.GetUserPreferences();

    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}


@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary-errors" data-valmsg-summary="true">
        <ul>

            @foreach (var m in ViewData.ModelState.Keys)
            {
                if (ViewData.ModelState[m].Errors.Count == 0)
                {
                    continue;
                }

                if (m.Contains("[") && m.Contains("]"))
                {
                    var index1 = m.IndexOf('[');
                    var index2 = m.IndexOf(']');
                    var property = m.Substring(0, index1);
                    var row = int.Parse(m.Substring(index1 + 1, index2 - index1 - 1)) + 1;

                    <li>@(LangHelpers.Instance[property] + " " + LangHelpers.Instance["the_row"] + " " + row + ": " + ViewData.ModelState[m].Errors.First().ErrorMessage)</li>
                }
                else
                {
                    <li>@ViewData.ModelState[m].Errors.First().ErrorMessage</li>
                }
            }
        </ul>

    </div>


}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="row divrtl">
        <div class="col-md-4 col-xs-4 login-label-bg">
            <p class="text-center login-label">@LangHelpers.Instance["email"]</p>
        </div>
        <div class="col-md-8 col-xs-8">
            @Html.TextBoxFor(m => m.UserName, new { @class = "text-center username login-input login-input-bg" })
            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="row divrtl nd2">
        <div class="col-md-4 col-xs-4 login-label-bg">
            <p class="text-center login-label">@LangHelpers.Instance["password"]</p>
        </div>
        <div class="col-md-8 col-xs-8">
            @Html.PasswordFor(m => m.Password, new { @class = "text-center username login-input login-input-bg" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>
    <div>
        @Html.Recaptcha(useSsl: SslBehavior.AlwaysUseSsl, language: LangHelpers.Instance["lang_code"], theme: RecaptchaTheme.Clean)

    </div>
    <div class="row">

        <button type="submit" class="text-center btn btn-block btn-info">@LangHelpers.Instance["login"]</button>
    </div>

}

<div class="row">
    <small class="link pull-left"><a href="~/Account/SendResetPasswordEmail" class="text-center">@LangHelpers.Instance["forgot_password"]</a></small>

    <small class="link pull-right"><a href="~/Account/register" class="text-center">@LangHelpers.Instance["register_new_user"]</a></small>
    <div class="clearfix"></div>

</div>


<br />
<p class="text-center">
    <a href="@Url.Action("UserGuide", "About")" target="_blank" class="btn btn-success">
        <span>@ArfStrings.user_guide</span>
    </a>
</p>