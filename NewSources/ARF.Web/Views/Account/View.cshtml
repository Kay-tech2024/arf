
@model ARF.Web.Models.registrationtestModel

@{
    ViewBag.Title = @LangHelpers.Instance["register_new_user"];

}

<h2>@LangHelpers.Instance["register_new_user"]</h2>


@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()




    <div class="form-group">
        <label class="control-label col-sm-2" for="fullname">الاسم الكامل </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="fullname" placeholder="الاسم الكامل" name="fullname">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="mobile">رقم الجوال </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="mobile" placeholder="رقم الجوال" name="mobile">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="dob">تاربخ الميلاد </label>
        <div class="col-sm-10">
            <input type="text" class="form-control datepicker" id="dob" placeholder="تاريخ الميلاد" name="dob">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="university">جامعة التخرج            </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="university" placeholder="جامعة التخرج" name="university">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="major">التخصص </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="major" placeholder="التخصص" name="major">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="nationality">الجنسية </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="nationality" placeholder="الجنسية" name="nationality">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="country">البلد </label>
        <div class="col-sm-10">
            <select class="form-control" id="country" name="country">
                <option selected>اختار...</option>
                <option>المملكة العربية السعودية</option>
                <option>الامارات  </option>
                <option>بحرين  </option>
                <option>عمن  </option>
                <option>الخ  </option>

            </select>
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="address">@LangHelpers.Instance["address"] </label>
        <div class="col-sm-10">
            <textarea rows="5" class="form-control" id="address" placeholder="العنوان" name="address"></textarea>
        </div>
    </div>


    <div class="form-group">
        <label class="control-label col-sm-2" for="email">@LangHelpers.Instance["email"]</label>
        <div class="col-sm-10">
            <input type="email" class="form-control" id="email" placeholder="@LangHelpers.Instance["email_confirmation"]" name="email">
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-sm-2" for="pwd">:</label>
        <div class="col-sm-10">
            <input type="password" class="form-control" id="pwd" placeholder="@LangHelpers.Instance["pass_code"] name="pwd">
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-sm-2" for="confirmpwd">@LangHelpers.Instance["pass_code_confirm"]:</label>
        <div class="col-sm-10">
            <input type="password" class="form-control" id="confirmpwd" placeholder=" pass_code_confirm" name="confirmpwd">
        </div>
    </div>




}


<div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
        <button type="submit" class="btn btn-default">@LangHelpers.Instance["send"]</button>
    </div>
</div>