@model ARF.Web.Models.RegistrationViewModel

@{
    ViewBag.Title = @LangHelpers.Instance["register_as_researcher"];
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    Model.Role = ArfUserRole.Researcher;
}



@if (Model.Step < 1)
{
    Model.Step = 1;
}
else if (Model.Step > 5)
{
    Model.Step = 5;
}



<link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap-datetimepicker@(LangHelpers.Instance["css_suffix"]).css" />
<link rel="stylesheet" type="text/css" href="~/Content/css/calendar@(LangHelpers.Instance["css_suffix"]).css" />

<div class="row">
    <div class="col-md-12">

        <div class="step-wizard-container2 step5">

            <div class="step-wizard">
                <div class="progress2">
                    <div class="progressbar2 empty"></div>
                    <div id="prog" class="progressbar2"></div>
                </div>
                <ul>
                    @for (var i = 0; i < 5; i++)
                    {
                        <li class="@(i + 1 == Model.Step ? "active" : "")">
                            <a href="@Utils.GetRegisterLink(Model.Role.Value, i + 1)">
                                <span class="step2">@(i + 1)</span>

                            </a>
                            <br />
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<h2>@ViewBag.ResearcherPageTitle</h2>



@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary-errors" data-valmsg-summary="true">
        <ul>

            @foreach (var m in ViewData.ModelState.Keys)
            {
                if (ViewData.ModelState[m].Errors.Count == 0)
                {
                    continue;
                }

                if (m.Contains("[") && m.Contains("]"))
                {
                    var index1 = m.IndexOf('[');
                    var index2 = m.IndexOf(']');
                    var property = m.Substring(0, index1);
                    var row = int.Parse(m.Substring(index1 + 1, index2 - index1 - 1)) + 1;

                    <li>@(LangHelpers.Instance[property] + " " + LangHelpers.Instance["the_row"] + " " + row + ": " + ViewData.ModelState[m].Errors.First().ErrorMessage)</li>
                }
                else
                {
                    <li>@ViewData.ModelState[m].Errors.First().ErrorMessage</li>
                }
            }
        </ul>

    </div>


}

<form action="@Utils.GetRegisterLink(Model.Role.Value, Model.Step)" method="post" class="form-horizontal" enctype="multipart/form-data">
