            <label class="control-label col-md-4 larger-text">@LangHelpers.Instance["cv"]</label>
            <div class="col-md-8">
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table">
                    <tbody>
                        <tr class="row-section-header required">
                            <td>
                                <a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionCareerHistory"]</a>
                            </td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionCareerHistory" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionCareerHistory">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionCareerHistory, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionAcademicHistory"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionAcademicHistory" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionAcademicHistory">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionAcademicHistory, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionPublishedPapers"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionPublishedPapers" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionPublishedPapers">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionPublishedPapers, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionInterests"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionInterests" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionInterests">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionInterests, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionMemberships"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="SectionMemberships" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionMemberships">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionMemberships, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionAwards"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionAwards" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionAwards">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionAwards, new { rows = 3, @class = "form-control rich-text-editor small" })
                            </td>
                        </tr>
                        <tr class="row-section-header required">
                            <td><a class="field-caption" style="margin-right: 60px;" href="#">@LangHelpers.Instance["SectionTrainingCourses"]</a></td>
                            <td><span class="color-red"></span></td>
                            <td><a data-toggle="dont-collapse" data-target="#CvSectionTrainingCourses" href="#" class="btn-edit-section btn btn-warning">@LangHelpers.Instance["add"]</a></td>
                        </tr>
                        <tr class="collapse row-section-details" id="CvSectionTrainingCourses">
                            <td colspan="3">
                                @Html.TextAreaFor(m => @m.SectionTrainingCourses, new { rows = 3, @class = "form-control rich-text-editor small" })
