            <div class="col-md-8">
                @Html.TextBoxFor(m => m.BankOther, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.BankOther)
            </div>
        </div>

        <div class="form-group">
            @*@Html.LabelFor(m => m.BankBranch, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["BankBranch"]</label>

            <div class="col-md-8">
                @Html.TextBoxFor(m => m.BankBranch, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.BankBranch)
            </div>
        </div>

        <div class="form-group required">
            @*@Html.LabelFor(m => m.BankAccountHolderName, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["BankAccountHolderName"]</label>

            <div class="col-md-8">
                @Html.TextBoxFor(m => m.BankAccountHolderName, new { @class = "form-control", @placeholder = LangHelpers.Instance["account_holder_name"] })
            </div>
        </div>

        <div class="form-group required">
            @*@Html.LabelFor(m => m.BankAccountIBAN, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["BankAccountIBAN"]</label>

            <div class="col-md-8">
                @Html.TextBoxFor(m => m.BankAccountIBAN, new { @class = "form-control", @placeholder = LangHelpers.Instance["iban"] })
            </div>
        </div>

        <div class="form-group required">
            @*@Html.LabelFor(m => m.BankIbanPhotocopy, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["BankIbanPhotocopy"]</label>

            <div class="col-md-8">
