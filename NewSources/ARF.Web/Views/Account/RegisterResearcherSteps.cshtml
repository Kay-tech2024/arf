                    </span>
                </div>
            </div>
        </div>

        <div id="divPhoneVerification" class="form-group required" style="display: none;">
            @Html.HiddenFor(m => m.SmsKey)
            @*@Html.LabelFor(m => m.SmsCode, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["SmsCode"]</label>

            <div class="col-md-8">
                <div class="input-group">
                    @Html.TextBoxFor(m => m.SmsCode, new { @class = "form-control", @placeholder = LangHelpers.Instance["sms_code"] })
                    <span class="input-group-btn">
                        <a id="btnVerifyMobile" href="#" class="btn btn-default">@LangHelpers.Instance["verify"]</a>
                    </span>
                </div>
            </div>
        </div>

        <div id="divPhoneVerificationInfo" class="alert alert-info text-center" style="display: none;"></div>
        <br />
        <hr />
        <h4>@LangHelpers.Instance["email_verification"]</h4>
        <div class="form-group required">
            @*@Html.LabelFor(m => m.Email, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["Email"]</label>

            <div class="col-md-8">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = LangHelpers.Instance["email"] })
            </div>
        </div>

        <div class="form-group required">
            @*@Html.LabelFor(m => m.EmailConfirmation, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["EmailConfirmation"]</label>

            <div class="col-md-8">
                @Html.TextBoxFor(m => m.EmailConfirmation, new { @class = "form-control", @placeholder = LangHelpers.Instance["email_confirmation"] })
            </div>
        </div>

        <p class="text-center">
            <a id="btnSendVerifyEmail" href="#" class="btn btn-danger">@LangHelpers.Instance["send_verification_code"]</a>
        </p>


        <div id="divEmailVerification" class="form-group required" style="display: none;">
            @Html.HiddenFor(m => m.EmailKey)
            @*@Html.LabelFor(m => m.EmailCode, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["EmailCode"]</label>

            <div class="col-md-8">
                <div class="input-group">
                    @Html.TextBoxFor(m => m.EmailCode, new { @class = "form-control", @placeholder = LangHelpers.Instance["email_code"] })
                    <span class="input-group-btn">
                        <a id="btnVerifyEmail" href="#" class="btn btn-default">@LangHelpers.Instance["verify"]</a>
                    </span>
                </div>
            </div>
        </div>

        <div id="divEmailVerificationInfo" class="alert alert-info text-center" style="display: none;"></div>


        <input id="hdnIsMobileVerified" value="@(ViewBag.IsMobileVerified == true? "1":"0")" type="hidden" />
        <input id="hdnIsEmailVerified" value="@(ViewBag.IsEmailVerified == true? "1":"0")" type="hidden" />
    }





    else if (Model.Step == 5)
    {
        <div class="form-group required">
            @*@Html.LabelFor(m => m.Password, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["Password"]</label>

            <div class="col-md-8">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = LangHelpers.Instance["password"] })
            </div>
        </div>

        <div class="form-group required">
            @*@Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label col-md-4" })*@
            <label class="control-label col-md-4">@LangHelpers.Instance["ConfirmPassword"]</label>

            <div class="col-md-8">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = LangHelpers.Instance["password_confirmation"] })
            </div>
        </div>




    }


    @if (Model.Step == 5)
    {
        <div class="form-group">
            <div class="col-md-8 col-md-offset-4">
                <button id="btnSubmit" type="submit" class="btn btn-success btn-block btn-60px">@LangHelpers.Instance["register"]</button>
            </div>
        </div>
    }
    else if (Model.Step > 1)
    {
        <div class="form-group">
            <div class="col-md-2">
                <a href="@Utils.GetRegisterLink(Model.Role.Value, Model.Step-1)" class="btn btn-info btn-block btn-60px">@LangHelpers.Instance["prev_btn"]</a>
            </div>
            <div class="col-md-8"></div>
            <div class="col-md-2">
                <button id="btnSubmit" type="submit" class="btn btn-success btn-block btn-60px">@LangHelpers.Instance["next_btn"]</button>
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            <div class="col-md-2">

            </div>
            <div class="col-md-8"></div>
            <div class="col-md-2">
                <button id="btnSubmit" type="submit" class="btn btn-success btn-block btn-60px">@LangHelpers.Instance["next_btn"]</button>
            </div>
        </div>
    }
</form>

</div>

@section scripts
{
    <script type="text/javascript" src="~/Content/js/moment-with-locales.min.js" nonce="@Html.ScriptNonce()"></script>
    <script type="text/javascript" src="~/Content/js/bootstrap-datetimepicker.js" nonce="@Html.ScriptNonce()"></script>
    <script type="text/javascript" src="~/Content/js/calendar.js" nonce="@Html.ScriptNonce()"></script>
    <script type="text/javascript" src="~/Content/js/site.js" nonce="@Html.ScriptNonce()"></script>

    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        var step = @(Model.Step);
        var cities = @Html.Raw(Utils.SerializeObject(Model.Cities.Select(r => new { Id = r.Id, Name = r.Name })));

        var switchOther = function ($el) {
            var $otherEl = $el.closest('.form-group').next();
            var selected = $el.val();
            var selectedVal = null;
            try {
                selectedVal = parseInt(selected);
            } catch (e) {
                return;
            }

            if (selectedVal == NaN) return;

            if (selectedVal === 0) {
                $otherEl.slideDown();
            } else {
                $otherEl.find('input').val('');
                $otherEl.slideUp();
            }
        };

        onDomInserted('.other-dropdown', function (el) {

            $(el).on('change', function (e) {
                switchOther($(el));
                return false;
            });
        });

        onDomInserted('.row-section-header', function (el) {

            $(el).find('a').on('click', function (e) {

                var xel = $(el).next('.row-section-details');
                var attr = xel.attr('data-is-visible');

                if (attr === '1') {

                    xel.css('display', 'none').attr('data-is-visible', '0');
                } else {
                    var others = $('.row-section-details');
                    for (var i = 0; i < others.length; i++) {
                        $(others[i]).css('display', 'none').attr('data-is-visible', '0');
                    }
                    xel.css('display', 'table-row').attr('data-is-visible', '1');
                }

                e.preventDefault();
                return false;
            });
        });

        onDomInserted('.ddl-country', function (el) {

            $(el).change(function () {

                var $el = $(el);
                var selected = $el.val();

                var otherEl = $(el).closest('.form-group').next().find('select');

                otherEl.empty();

                var selectedVal = null;
                try {
                    selectedVal = parseInt(selected);
                } catch (e) {

                }

                if (selectedVal === 0) {
                } else {

                    $.getJSON(baseAjaxUrl + 'GetCities?countryId=' + selected + "&others=False", function (cats) {
                        var secCateSelect = otherEl;
                        secCateSelect.empty();
                        secCateSelect.html('<option></option>');

                            secCateSelect.empty();
                         secCateSelect.append($('<option />', {
                        value: '', text: '@LangHelpers.Instance["select"]'
                        }));


                        $.each(cats, function (index, cat) {

                            secCateSelect.append($('<option />', {
                                value: cat.value,
                                text: cat.text
                            }));
                        });

                        secCateSelect.append($('<option />', {
                            value: '0',
                            text: '@ArfStrings.other'
                        }));
                    });
                }
            });
        });


         onDomInserted('.ddl-college', function (el) {

            $(el).change(function () {

                var $el = $(el);
                var selected = $el.val();

                var uniEl = $(el).closest('.form-group').prev().find('select');
                var otherEl = $(el).closest('.form-group').next().find('select');

                if (otherEl == null || otherEl.length === 0 || !otherEl.attr('name').endsWith('DepartmentId')) {
                    otherEl = $(el).closest('.form-group').next().next().find('select');

                    uniEl = $(el).closest('.form-group').prev().prev().find('select');
                }

                var hasSelectPicker = false &&  isFunction(otherEl.selectpicker) && otherEl.hasClass('selectpicker');

                otherEl.empty();

                switchOther(otherEl);

                if (hasSelectPicker) {
                    otherEl.selectpicker('refresh');

                }

                var selectedVal = null;
                try {
                    selectedVal = parseInt(selected);
                } catch (e) {

                }

                if (selectedVal === 0) {
                } else {

                    $.getJSON(baseAjaxUrl + 'GetDepartments?dontFilter=1&&collegeId=' + selected + "&others=False", function (cats) {
                        var secCateSelect = otherEl;
                        secCateSelect.empty();
                         secCateSelect.append($('<option />', {
                        value: '', text: '@LangHelpers.Instance["select"]'
                        }));



                        $.each(cats, function (index, cat) {

                            secCateSelect.append($('<option />', {
                                value: cat.value,
                                text: cat.text
                            }));
                        });

                        if (uniEl.val() != 1) {
                            secCateSelect.append($('<option />', {
                                value: '0',
                                text: '@ArfStrings.other'
                            }));
                        }


                        if (cats.length === 0) {
                            secCateSelect.val('0');
                            switchOther(secCateSelect);
                        }

                        if (hasSelectPicker) {
                            secCateSelect.selectpicker('refresh');
                            otherEl.selectpicker('refresh');
                        }

                    });
                }
            });
        });

        // Email && mobile verification
         if (step === 4) {
             var validateVerification = function () {
                 if ($("#Email").val() != "") {
                     $("#EmailConfirmation").val($("#Email").val());
                     $("#Email").attr("readonly", "readonly");
                     $("#EmailConfirmation").attr("readonly", "readonly");
                 }

                 var mobileVerified = $('#hdnIsMobileVerified').val() === '1';
                 var emailVerified = $('#hdnIsEmailVerified').val() === '1';

                 if (!mobileVerified || !emailVerified) {
                     $('#btnSubmit').addClass('disabled');
                     return false;
                 }


                 $('#btnSubmit').removeClass('disabled');
                 return true;

             };


             var sendSmsCode = function () {
                 var mobile = $('#MobileNumber').val();
                 if (!mobile) return;
                 $('#divPhoneVerificationInfo').slideUp();
                 $.getJSON(baseAjaxUrl + 'SendVerificationCode?type=SMS&to=' + mobile, function (res) {
                     if (!res) return;
                     if (res.success == true) {
                         $('#SmsKey').val(res.key);
                         $('#divPhoneVerification').slideDown();
                         $('#divPhoneVerificationInfo').slideUp();
                         $('#SmsCode').val('');
                     } else {
                         if (res.isVerified === true) {
                             $('#hdnIsMobileVerified').val('1');
                             validateVerification();
                         }
                         $('#divPhoneVerification').slideUp();
                         $('#divPhoneVerificationInfo').html(res.msg).slideDown();
                     }
                 });
             };

             $('#btnSendVerifyMobile').click(function (ev) {

                 sendSmsCode();

                 ev.preventDefault();
                 return false;
             });


             $('#btnVerifyMobile').click(function () {
                 var mobile = $('#MobileNumber').val();
                 var key = $('#SmsKey').val();
                 var code = $('#SmsCode').val();
                 if (!mobile) return;
                 $('#divPhoneVerificationInfo').slideUp();

                 $.getJSON(baseAjaxUrl + 'VerifyCode?type=SMS&to=' + mobile + '&key=' + key + '&code=' + code, function (res) {
                     if (!res) return;
                     if (res.success == true) {
                         $('#divPhoneVerificationInfo').html('<span class="glyphicon glyphicon-ok" style="display: inline;"></span>').slideDown();
                     } else {
                         if (res.isVerified === true) {
                             $('#hdnIsMobileVerified').val('1');
                             validateVerification();
                         }

                         $('#divPhoneVerificationInfo').html(res.msg).slideDown();
                     }
                 });

                 ev.preventDefault();
                 return false;
             });

             var validateEmail = function () {
                 var email = $('#Email').val();
                 var emailConfirmation = $('#EmailConfirmation').val();
                 if (!email || !emailConfirmation || email.trim().length === 0 || email != emailConfirmation) {
                     $('#btnSendVerifyEmail').addClass('disabled');
                     return false;
                 }


                 $('#btnSendVerifyEmail').removeClass('disabled');
                 return true;
             };

             $('#MobileNumber').on("input", function (e) {
                 $('#hdnIsMobileVerified').val('0');
             });

             $('#Email,#EmailConfirmation').on("input", function (e) {
                 $('#hdnIsEmailVerified').val('0');
                 validateEmail();
             });


             $('#Email').bind("cut copy paste", function (e) {
                 e.preventDefault();
             });

             $('#EmailConfirmation').bind("cut copy paste", function (e) {
                 e.preventDefault();
             });


             var sendEmailCode = function () {
                 if (!validateEmail()) return false;

                 var email = $('#Email').val();
                 if (!email) return;


                 email = encodeURIComponent(email);


                 $('#divEmailVerificationInfo').slideUp();
                 $.getJSON(baseAjaxUrl + 'SendVerificationCode?imamOnly=True&type=Email&to=' + email, function (res) {
                     if (!res) return;
                     if (res.success == true) {
                         $('#hdnIsMobileVerified').val('1');
                         validateVerification();
                         $('#EmailKey').val(res.key);
                         $('#divEmailVerification').slideDown();
                         $('#divEmailVerificationInfo').slideUp();
                         $('#EmailCode').val('');
                     } else {
                         if (res.isVerified === true) {
                             $('#hdnIsEmailVerified').val('1');
                             validateVerification();
                         }

                         $('#divEmailVerification').slideUp();
                         $('#divEmailVerificationInfo').html(res.msg).slideDown();
                     }
                 });
             };

             $('#btnSendVerifyEmail').click(function (ev) {
                 sendEmailCode();

                 ev.preventDefault();
                 return false;
             });


             $('#btnVerifyEmail').click(function (ev) {
                 if (!validateEmail()) return false;

                 var email = $('#Email').val();
                 var key = $('#EmailKey').val();
                 var code = $('#EmailCode').val();
                 if (!email) return;


                 email = encodeURIComponent(email);

                 $('#divEmailVerificationInfo').slideUp();

                 $.getJSON(baseAjaxUrl + 'VerifyCode?type=Email&to=' + email + '&key=' + key + '&code=' + code, function (res) {
                     if (!res) return;
                     if (res.success == true) {
                         $('#hdnIsEmailVerified').val('1');
                         validateVerification();
                         $('#divEmailVerificationInfo').html('<span class="glyphicon glyphicon-ok" style="display: inline;"></span>').slideDown();
                     } else {
                         if (res.isVerified === true) {
                             $('#hdnIsEmailVerified').val('1');
                             validateVerification();
                         }

                         $('#divEmailVerificationInfo').html(res.msg).slideDown();
                     }
                 });

                 ev.preventDefault();
                 return false;

             });

             var validateEmail = function () {
                 var email = $('#Email').val();
                 var emailConfirmation = $('#EmailConfirmation').val();
                 if (!email || !emailConfirmation || email.trim().length === 0 || email != emailConfirmation) {
                     $('#btnSendVerifyEmail').addClass('disabled');
                     return false;
                 }


                 $('#btnSendVerifyEmail').removeClass('disabled');
                 return true;
             };

             validateEmail();

             $('#btnSubmit').on("click", function (e) {
                 if (!validateVerification()) {
                     e.preventDefault();
                     return false;
                 }
             });


             validateVerification();

         }
    </script>
}

