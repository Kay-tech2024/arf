@model ResetPasswordViewModel
@{

    var isPostBack = HttpContextManager.Current.Request.HttpMethod == "POST";
    var preferences = CommonManager.GetUserPreferences();

    ViewBag.Title = LangHelpers.Instance["reset_password"];

    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}


@using (Html.BeginForm("ResetPassword", "TempLinks", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Key)
    <div class="row divrtl nd2">
        <div class="col-md-4 col-xs-4 login-label-bg">
            <p class="text-center login-label">@LangHelpers.Instance["email"]</p>
        </div>
        <div class="col-md-8 col-xs-8">
            @Html.TextBoxFor(m => m.Email, new { @class = "text-center username login-input login-input-bg", @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="row divrtl nd2">
        <div class="col-md-4 col-xs-4 login-label-bg">
            <p class="text-center login-label">@LangHelpers.Instance["password"]</p>
        </div>
        <div class="col-md-8 col-xs-8">
            @Html.PasswordFor(m => m.Password, new { @class = "text-center username login-input login-input-bg" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="row divrtl nd2">
        <div class="col-md-4 col-xs-4 login-label-bg">
            <p class="text-center login-label">@LangHelpers.Instance["password_confirmation"]</p>
        </div>
        <div class="col-md-8 col-xs-8">
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "text-center username login-input login-input-bg" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="row">
        <button type="submit" class="text-center btn btn-block btn-info">@LangHelpers.Instance["reset_password"]</button>
    </div>


}


<div class="row">
    <small class="link"><a href="~/Account/login" class="text-center">@LangHelpers.Instance["login"]</a></small>
    <small class="link"><a href="~/Account/register" class="text-center">@LangHelpers.Instance["register_new_user"]</a></small>
</div>

