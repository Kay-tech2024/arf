@model CollegeViewModel

@{
    ViewBag.Title = LangHelpers.Instance["edit_college"];

}

<ul class="breadcrumb">
    <li><a href="@Url.Action("Index", "Home")">@LangHelpers.Instance["homepage"]</a></li>
    <li><a href="@Url.Action("Index", "Colleges")">@LangHelpers.Instance["colleges"]</a></li>
    <li>@LangHelpers.Instance["edit_college"]</li>
</ul>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-validation">
        <h5>@LangHelpers.Instance["ValidationSummary"]</h5>
        <div class="text-left">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
    </div>
}

<div class="box2 box2-info">

    @using (Html.BeginForm("Edit", "Colleges", new { id = Model.Id}, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal maximum-width" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.HiddenFor(model => model.Id)

            <div class="form-group">
                @Html.LabelFor(model => model.NameEnglish, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.TextBoxFor(model => model.NameEnglish, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.NameEnglish, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.NameArabic, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-9">
                    @Html.TextBoxFor(model => model.NameArabic, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.NameArabic, "", new { @class = "text-danger" })
                </div>
            </div>

            

            
            <div class="form-group">
                <div class="col-md-offset-3 col-md-9">
                    <input id="btnSubmit" type="submit" value="@LangHelpers.Instance["save"]" class="btn btn-primary btn-lg btn-block" />
                </div>
            </div>
            
        </div>
    }
</div>

