@model IEnumerable<ARF.Data.DbModels.FormSection>
<h2>Sections Edit</h2>
<h4>Form - @ViewBag.FormName</h4>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 text-center">
            <a href="@Url.Action("FormFields/"+item.FormId.ToString()+","+item.Id.ToString())" style="width:80%@(!item.IsActive?";background-color:#ccc": "")" class="btn btn-success @(item.IsActive?"btn-success": "btn-default")  btn-wide">@item.LocalizedName()</a>
            <a style="width:19%" class="btn btn-danger btn-wide edit-section" data-namear="@item.LocalizedName()" data-nameen="@item.NameEnglish" data-id="@item.Id" data-fid="@item.FormId" data-isactive="@item.IsActive" data-visibleroles="@item.VisibleToRoles" data-invisibleroles="@item.InvisibleToRoles">Edit</a>
        </div>
    }
</div>


<hr />

<div>
    <a class="btn btn-primary add-section" data-toggle="modal" data-target="#addEditSectionModal">Add Section</a>
</div>

<!-- Modal -->
<div id="addEditSectionModal" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Form</h4>
            </div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="form-horizontal">
                        <div class="hidden"><input name="FormId" id="FormId" class="form-control" value="@ViewBag.FormId" /></div>
                        <div class="hidden"><input name="SId" id="SId" class="form-control" /></div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Name Arabic</label>
                            <div class="col-md-9"><input name="NameArabic" id="NameArabic" class="form-control" /></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Name English</label>
                            <div class="col-md-9"><input name="NameEnglish" id="NameEnglish" class="form-control" /></div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Is Active</label>
                            <div class="col-md-9">@Html.CheckBox("IsActive", new { @class = "IsActive", @id = "IsActive" })@*<input id="IsActive" data-val="true" name="IsActive" type="checkbox" value="true">*@</div>

                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Roles Visible To</label>
                            <div class="col-md-9">
                                @Html.DropDownList("VisibleToRoles", (MultiSelectList)ViewBag.Roles@*new MultiSelectList(s, "Value", "Text", 0)*@, new { @class = "form-control VisibleToRoles", multiple = "multiple", @id = "VisibleToRoles" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-3">Roles Invisible To</label>
                            <div class="col-md-9">
                                @Html.DropDownList("InvisibleToRoles", (MultiSelectList)ViewBag.Roles@*new MultiSelectList(s, "Value", "Text", 0)*@, new { @class = "form-control InVisibleToRoles", multiple = "multiple", @id = "InVisibleToRoles" })
                            </div>
                        </div>

                    </div>

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Submit</button>

                    <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                </div>
            }
        </div>

    </div>
</div>



@section scripts{

    <script nonce="@Html.ScriptNonce()">
        $(document).on('click', '.edit-section', function () {

            $('#NameArabic').attr('value', $(this).data('namear'));
            $('#NameEnglish').attr('value', $(this).data('nameen'));
            $('#SId').attr('value', $(this).data('id'));
            $('#FormId').attr('value', $(this).data('fid'));
            $('#IsActive').removeAttr('checked').attr('value', 'true');
            var VisibleRoles = $(this).data('visibleroles');
            var VRs = VisibleRoles.split(',');
            var InVisibleRoles = $(this).data('invisibleroles');
            var iVRs = InVisibleRoles.split(',');
            //console.log(VRs);
            var isActive = $(this).data('isactive');
            $("#VisibleToRoles").val('');
            $("#VisibleToRoles").val(VRs);
            $("#InVisibleToRoles").val('');
            $("#InVisibleToRoles").val(iVRs);
            //console.log(isActive);
            if (isActive == 'True') {
                $('#IsActive').prop('checked', true).attr('value', 'true');
            } else {
                $('#IsActive').prop('checked', false).attr('value', 'true');
            }
            $('#addEditSectionModal').modal('show');
        });

        //add-form
        $(document).on('click', '.add-section', function () {
            $('#NameArabic').attr('value', '');
            $('#NameEnglish').attr('value', '');
            $('#SId').attr('value', '0');
            $('#FormId').attr('value', '@ViewBag.FormId');
            $('#IsActive').removeAttr('checked', 'false').attr('value', 'true');
            $("#VisibleToRoles").val('');
            $("#InVisibleToRoles").val('');
            $('#addEditFormModal').modal('show');
        });

        //reset the modal on close
        $('.modal').on('hidden.bs.modal', function (e) {
            $(this).removeData();
        });

        //reset the lists on show
        $('.modal').on('shown.bs.modal', function (e) {
            $('.InVisibleToRoles').scrollTop(0);
            $('.VisibleToRoles').scrollTop(0);
        });

    </script>

}