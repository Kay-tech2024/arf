@model LookupValuesEditModel
<h4>Edit Lookups</h4>

@if (Model.LookupValues == null) { Model.LookupValues = new List<ARF.Data.DbModels.LookupValue>(); }
<style>
    .field-validation-error {
        color: red;
        font-size: 12px;
    }
</style>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="form-fields-table">
            <thead>
                <tr>
                    <th class="text-center">Arabic Name</th>
                    <th class="text-center">English Name</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @{
                    var i = -1;
                }
                @foreach (var item in Model.LookupValues)
                {
                    i++;
                    <tr class="@(item.Id<0?"hidden": "available")">
                        @Html.HiddenFor(m => m.LookupValues[i].Id, new { @class = "Id" })
                        @Html.HiddenFor(m => m.LookupValues[i].LookupId, new { @class = "LookupId" })
                        <td>@Html.TextBoxFor(m => Model.LookupValues[i].NameArabic, new { @class = "form-control NameArabic", @id = "NameArabic" })<p>@Html.ValidationMessageFor(m => m.LookupValues[i].NameArabic)</p></td>
                        <td>@Html.TextBoxFor(m => Model.LookupValues[i].NameEnglish, new { @class = "form-control NameEnglish", @id = "NameEnglish" })<p>@Html.ValidationMessageFor(m => m.LookupValues[i].NameEnglish)</p></td>
                        <td><a class="btn btn-xs btn-danger btn-remove"><i class="fa fa-trash-o"></i></a></td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
    <a class="btn btn-primary add-row">Add Field</a>
    <button type="submit" class="btn btn-success">Submit</button>

}

@section scripts{
    <!-- jQuery UI CSS -->
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.11.2/jquery-ui.min.js" nonce="@Html.ScriptNonce()"></script>

    <script type="text/javascript" nonce="@Html.ScriptNonce()">

        $(document).ready(function () {
            //Helper function to keep table row from collapsing when being sorted
            var fixHelperModified = function (e, tr) {
                var $originals = tr.children();
                var $helper = tr.clone();
                $helper.children().each(function (index) {
                    $(this).width($originals.eq(index).width())
                });
                return $helper;
            };

            //Make diagnosis table sortable
            $("#form-fields-table tbody").sortable({
                helper: fixHelperModified,
                stop: function (event, ui) { renumber_table('#form-fields-table') }
            }).disableSelection();


            //Delete button in table rows
            $(document).on('click', '.btn-remove', function () {
                tableID = '#' + $(this).closest('table').attr('id');
                r = confirm('Delete this item?');
                if (r) {
                    $(this).closest('tr').removeClass('available').addClass('hidden');//.remove();
                    $(this).closest('tr').find('.IsActive').attr('value', 'False');
                    renumber_table(tableID);
                }
            });

            $(document).on('click', '.add-row', function () {
                tableID = '#form-fields-table';
                var count = $('#form-fields-table tbody').find('tr').length;
                var tr = $("<tr class='available'>" + $('#form-fields-table tbody').find('tr').eq(0).html() + "</tr>");
                tr.find('.Id').attr('value', 0).attr('Id', 'LookupValues_' + count + '__Id').attr('name', 'LookupValues[' + count + '].Id');
                tr.find('.LookupId').attr('Id', 'LookupValues_' + count + '__LookupId').attr('name', 'LookupValues[' + count + '].LookupId');
                tr.find('.NameArabic').attr('value', '').attr('Id', 'LookupValues_' + count + '__NameArabic').attr('name', 'LookupValues[' + count + '].NameArabic');
                tr.find('.NameEnglish').attr('value', '').attr('Id', 'LookupValues_' + count + '__NameEnglish').attr('name', 'LookupValues[' + count + '].NameEnglish');

                $('#form-fields-table tbody').append(tr);
                renumber_table(tableID);
            });
        });
        //Renumber table rows
        function renumber_table(tableID) {
            $(tableID + " tr").each(function (index, value) {
                count = $(this).parent().children('.available').index($(this));
                $(this).find('.Order').attr('value', count + 1);
            });
        }



    </script>


}