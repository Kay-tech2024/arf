@{
    Layout = null;
    ViewBag.Title = "آلة الزمن";
    var isArabic = true;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ArfStrings.site_title_long - @ViewBag.Title</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <link rel="stylesheet" media="screen" href="~/Content/css/fonts.css" type="text/css" />
    <link href="~/Content/css/bootstrap@(isArabic? "-rtl" : "").css" rel="stylesheet" />
    <link href="~/Content/css/survey-viewer@(isArabic? "-rtl" : "").css" rel="stylesheet" />

    <script src="~/Content/js/jquery.js" nonce="@Html.ScriptNonce()"></script>

    <style type="text/css">
        html
        {
            height: 100%;
        }

        body
        {
            background: url('@(Utils.GetApplicationUrl())Content/img/timemachine.jpg') no-repeat;
            background-size: cover;
            padding-top: 30px;
            text-align: center;
            overflow-x: hidden;
            color: cornflowerblue;
            display: flex;
            align-items: center;
            height: 100%;
            background-position: center center;
        }

        input[type=radio]
        {
            height: 20px;
            width: 20px;
            margin: 10px;
            vertical-align: middle;
        }

        form
        {
            max-width: 600px;
            margin: 0 auto;
            background: rgba(255,255,255,0.7);
            padding: 20px;
            border-radius: 20px;
            flex: 1;
        }
        .consnet-description {
            margin: 20px;
            line-height: 2.5;
        }

        .control-label
        {
            padding: 20px;
        }

        .form-group
        {
            display: block;
            text-align: left;
            width: 500px;
            margin: 10px auto !important;
        }

        .form-control
        {
            display: inline-block;
            width: 100px;
        }
    </style>

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body>

    @using (Html.BeginForm("Index", "TimeMachine", null, FormMethod.Post, new { @class = "form-horizontal maximum-width" }))
    {
        @Html.AntiForgeryToken()
        <h2>مرحبًا بكم في آلة الزمن! ☺</h2>
        <br />

        <div class="form-group">
            <label class="control-label col-md-3">التاريخ</label>

            <div class=" col-md-9" style="direction: ltr; display: inline-block;">
                <input type="number" class="form-control" name="yy" placeholder="أدخل السنة (e.g. 2009).." value="@(ViewBag.yy == null? "" : ViewBag.yy)" />

                <input type="number" class="form-control" name="mo" placeholder="أدخل الشهر (e.g. 09).." value="@(ViewBag.mo == null? "" : ViewBag.mo)" />

                <input type="number" class="form-control" name="dd" placeholder="أدخل اليوم (e.g. 18).." value="@(ViewBag.dd == null? "" : ViewBag.dd)" />
            </div>

        </div>


        <div class="form-group">
            <label class="control-label col-md-3">الوقت</label>

            <div class=" col-md-9" style="direction: ltr; display: inline-block;">
                <input type="number" class="form-control" name="hh" placeholder="أدخل الساعة(e.g. 22).." value="@(ViewBag.hh == null? "" : ViewBag.hh)" />

                <input type="number" class="form-control" name="mm" placeholder="أدخل الدقيقة (e.g. 45).." value="@(ViewBag.mm == null? "" : ViewBag.mm)" />
            </div>
        </div>


        <div class="form-group">


            <input type="radio" class="form-control" name="IsSystemWide" value="True" @(ViewBag.IsSystemWide == true ? "checked" : "") /> تطبيق على مستوى النظام

            <input type="radio" class="form-control" name="IsSystemWide" value="False" @(ViewBag.IsSystemWide != true ? "checked" : "") /> تطبيق على مستوى المستخدم

        </div>


        <div class="text-center">
            <input id="btnSubmit" type="submit" name="submit" value="هيا ننطلق بحول الله!" class="btn btn-primary btn-lg submit-button" />

            <a href="~/TimeMachine/Reset" value="Reset" class="btn btn-warning btn-lg submit-button">استعادة الوقت الأصلي</a>
        </div>

    }
</body>
</html>