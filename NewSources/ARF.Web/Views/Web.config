<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <configSections>
    <sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
      <section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
      <section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <system.web.webPages.razor>
    <host factoryType="System.Web.Mvc.MvcWebRazorHostFactory, System.Web.Mvc, Version=5.2.3.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
    <pages pageBaseType="System.Web.Mvc.WebViewPage">
      <namespaces>
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="ARF.Web" />
        <add namespace="ARF.Web.Resources" />
        <add namespace="ARF.Data" />
        <add namespace="ARF.TimeMachine" />
        <add namespace="ARF.Core" />
        <add namespace="ARF.Core.Models" />
        <add namespace="ARF.Core.Managers" />
        <add namespace="ARF.Web.Models" />
        <add namespace="ARF.Web.App_Start.Code" />
        <add namespace="ARF.Web.App_Start.Extensions" />
        <add namespace="ARF.Web.App_Start.DWF"/>
        <add namespace="Recaptcha.Web"/>
        <add namespace="Recaptcha.Web.Mvc"/>
        <add namespace="Microsoft.AspNet.Identity" />
        <add namespace="Microsoft.Owin.Security" />
        <add namespace="MVCGrid.Web" />
      </namespaces>
    </pages>
  </system.web.webPages.razor>

  <appSettings>
    <add key="webpages:Enabled" value="false" />
    <add key="smtp:Debug" value="True" />
    <add key="smtp:Host" value="mailtrap.io" />
    <add key="smtp:Port" value="25" />
    <add key="smtp:FromEmail" value="ecs-info@hrdf.org.sa" />
    <add key="smtp:SSL" value="true" />
    <add key="smtp:Username" value="502222b460e47cc8a" />
    <add key="smtp:Password" value="__SET_ME__" />
  </appSettings>

  <system.webServer>
    <handlers>
      <remove name="BlockViewHandler" />
      <add name="BlockViewHandler" path="*" verb="*" preCondition="integratedMode" type="System.Web.HttpNotFoundHandler" />
    </handlers>
  </system.webServer>

  <system.web>
    <compilation>
      <assemblies>
        <add assembly="System.Web.Mvc, Version=5.2.3.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
  </system.web>
</configuration>