    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>
<body style="direction: @LangHelpers.Instance["css_dir"];">
    <a href="@Url.Action("ContactUs", "About")">
        <span>@ArfStrings.contactus</span>
    </a>

    <a href="@Utils.GetLocalizedFullUrl(ArfStrings.other_lang)" class="pull-right">
        <span>@ArfStrings.other_lang_long</span>
    </a>
    <div class="container" style="margin-bottom: 30px;">

        <div class=" login-pg">
            @{
                var message = (string)null;
                var message_type = (string)null;
                var message_link = (string)null;

                if (!string.IsNullOrWhiteSpace(ViewBag.Message))
                {
                    message = ViewBag.Message;
                    message_type = ViewBag.MessageType;
                    message_link = ViewBag.MessageLink;
                }
                else if (TempData["message"] != null && !string.IsNullOrWhiteSpace((string)TempData["message"]))
                {
                    message = (string)TempData["message"];
                    message_type = (string)TempData["message_type"];
                    message_link = (string)TempData["message_link"];
                }

                if (!string.IsNullOrWhiteSpace(message))
                {

                    if (string.IsNullOrWhiteSpace(message_type))
                    {
                        message_type = "success";
                    }

                    if (!string.IsNullOrWhiteSpace(message_link))
                    {
                        message = message.Replace("<link>", "<a href=\"" + message_link + "\">").Replace("</link>", "</a>");
                    }

                    <div class="max-600-margin alert alert-@message_type">@Html.Raw(message)</div>
                }

            }

            <div>
                <a href="~/"><img src="~/Content/aps/imgs/logo-1.png" class="img-responsive center-block" /></a>
                <br />
            </div>

            @RenderBody()
        </div>
    </div>
    <!-- Include all compiled plugins (below), or include individual files as needed -->
    @Scripts.Render("~/Content/js/admin_js_login")

    @if (ViewBag.IncludeCKEditor == true)
    {
        <!-- Main Quill library -->
        <script src="~/Content/js/quill.min.js" nonce="@Html.ScriptNonce()"></script>
        <script src="~/Content/js/image-resize.min.js" nonce="@Html.ScriptNonce()"></script>
        <script src="~/Content/js/quill.table.js" nonce="@Html.ScriptNonce()"></script>
        <script src="~/Content/js/site.js" nonce="@Html.ScriptNonce()"></script>

        <!-- Theme included stylesheets -->
        <link href="~/Content/css/quill.snow.css" rel="stylesheet">
        <link href="~/Content/css/quill.table.css" rel="stylesheet">

        <script type="text/javascript" nonce="@Html.ScriptNonce()">
            var did = 0;
            onDomInserted('.rich-text-editor', function (el) {
                var val = $(el).val();
                if (!val) val = '';

                let maxRows = 10;
                let maxCols = 5;
                let tableOptions = [];
                for (let r = 1; r <= maxRows; r++) {
                    for (let c = 1; c <= maxCols; c++) {
                        tableOptions.push('newtable_' + r + '_' + c);
                    }
                }

                if (el.attr('id') === undefined) {
                    var id = 'dynamic_id_' + (did++);
                    while (document.getElementById(id) !== null) {
                        id = 'dynamic_id_' + (did++);
                    }

                    el.attr('id', id);
                }

                var form = $(el).closest('form');

                var newDiv = $('<div id="' + $(el).attr('id') + '">' + val + '</div>');

                var about = $('<input type="hidden" name="' + $(el).attr('name') + '" value="" />');
                el.parent().append(about)
                $(el).replaceWith(newDiv);

                var quill = new Quill('#' + el.attr('id'), {
                    modules: {
                        imageResize: {
                            displaySize: true
                        },
                        toolbar: [
                            // Extended toolbar buttons
                            //['contain'],
                            //[{ 'table': tableOptions }], // new table (cursor needs to be out of table)
                            //[{ 'table': 'append-row' }], // cursor needs to be in the table
                            //[{ 'table': 'append-col' }], // cursor needs to be in the table
                            [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                            [{ 'font': [] }],
                            [{ 'align': [] }],
                            ['bold', 'italic', 'underline', 'strike'],        // toggled buttons
                            [{ 'color': [] }, { 'background': [] }],          // dropdown with defaults from theme
                            ['link', 'image'],

                            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                            [{ 'script': 'sub' }, { 'script': 'super' }],      // superscript/subscript
                            [{ 'indent': '-1' }, { 'indent': '+1' }],          // outdent/indent
                            [{ 'direction': 'rtl' }],                         // text direction

                        ]
                    },
                    theme: 'snow'
                });

                if (form && form.length > 0) {

                    form.on('submit', function (e) {
                        // Populate hidden form on submit
                        var html = quill.container.firstChild.innerHTML;
                        about.val(html);

                    });

                }
            });
        </script>
    }

    @RenderSection("scripts", false)

    @{
        var ad = Utils.db.Advertisements
           .OrderByDescending(x => x.Created)
           .FirstOrDefault(x => x.IsActivated == true && (x.VisibleFrom < DateTime.Now || x.VisibleFrom == null) && (x.VisibleUntil > DateTime.Now || x.VisibleUntil == null));

        var userId = Utils.UserUtils.CurrentUser == null ? null : Utils.UserUtils.CurrentUser.Id;
        var sessionId = Utils.UserUtils.UserSession == null ? (long?)null : Utils.UserUtils.UserSession.Id;
        if (ad != null && ad.AdvertisementViews.Count(x => x.SessionId == sessionId || (userId != null && x.UserId == userId)) == 0)
        {
            <div id="modal-container">
                <div class="modal-background">
                    <div class="modal">
                        <div class="">
                            @Html.Raw(ad.ContentArabic.Replace("~/", Utils.GetApplicationUrl()))
                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript" nonce="@Html.ScriptNonce()">
                var buttonId = 'one';
                $('#modal-container').removeAttr('class').addClass(buttonId);
                $('body').addClass('modal-active');

                $('#modal-container').click(function () {
                    $(this).addClass('out');
                    $('body').removeClass('modal-active');

                    $.ajax({
                        url: baseAjaxUrl + "JustSawIt?id=@ad.Id",
                    }).done(function () {

                    });
                });
            </script>
        }
    }

    @if (!Utils.IsLocalhost)
    {

        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-115800046-1" nonce="@Html.ScriptNonce()"></script>
        <script nonce="@Html.ScriptNonce()">
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());

            gtag('config', 'UA-115800046-1');
        </script>

        <!--Start of Zendesk Chat Script-->
        <script type="text/javascript" nonce="@Html.ScriptNonce()">
            window.$zopim || (function (d, s) {
                var z = $zopim = function (c) { z._.push(c) }, $ = z.s =
                    d.createElement(s), e = d.getElementsByTagName(s)[0]; z.set = function (o) {
                        z.set.
                            _.push(o)
                    }; z._ = []; z.set._ = []; $.async = !0; $.setAttribute("charset", "utf-8");
                $.src = "https://v2.zopim.com/?5ZDnD0FcELayweNNfu0yMY0HOI02suFO"; z.t = +new Date; $.
                    type = "text/javascript"; e.parentNode.insertBefore($, e)
            })(document, "script");
        </script>
        <!--End of Zendesk Chat Script-->

    }
</body>
</html>