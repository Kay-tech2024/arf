@foreach (var reqBeni in Model.RequestBenificialList)
{<hr />
    <h4 class="title">@LangHelpers.Instance["BeneficiariesOfTheResearchOutputs"]</h4>
    <div class="form-group">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th style="color:#1a5b92">م</th>
                    <th style="color:#1a5b92">@LangHelpers.Instance["Organization"]</th>
                    <th style="color:#1a5b92">@LangHelpers.Instance["ItsAddress"]</th>
                    <th style="color:#1a5b92">@LangHelpers.Instance["DescribeTheirUtilization"]</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>
                        @reqBeni.Title
                    </td>
                    <td>
                        @reqBeni.Address
                    </td>
                    <td>
                        @reqBeni.Description
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <hr />
}
<script nonce="@Html.ScriptNonce()">
    $(".form-control-view").attr("disabled", "disabled");
</script>