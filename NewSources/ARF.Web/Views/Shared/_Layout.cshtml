        {

            <!-- Main Quill library -->
            <script src="~/Content/js/quill.min.js" nonce="@Html.ScriptNonce()"></script>
            <script src="~/Content/js/image-resize.min.js" nonce="@Html.ScriptNonce()"></script>
            <script src="~/Content/js/quill.table.js" nonce="@Html.ScriptNonce()"></script>

            <!-- Theme included stylesheets -->
            <link href="~/Content/css/quill.snow.css" rel="stylesheet">
            <link href="~/Content/css/quill.table.css" rel="stylesheet">

            <script type="text/javascript" nonce="@Html.ScriptNonce()">
                var did = 0;
                onDomInserted('.rich-text-editor', function (el) {
                    var val = $(el).val();
                    if (!val) val = '';

                    let maxRows = 10;
                    let maxCols = 5;
                    let tableOptions = [];
                    for (let r = 1; r <= maxRows; r++) {
                        for (let c = 1; c <= maxCols; c++) {
                            tableOptions.push('newtable_' + r + '_' + c);
                        }
                    }

                    if (el.attr('id') === undefined) {
                        var id = 'dynamic_id_' + (did++);
                        while (document.getElementById(id) !== null) {
                            id = 'dynamic_id_' + (did++);
                        }

                        el.attr('id', id);
                    }

                    var form = $(el).closest('form');

                    var newDiv = $('<div id="' + $(el).attr('id') + '">' + val + '</div>');
                    var about = $('<input type="hidden" name="' + $(el).attr('name') + '" value="" />');
                    el.parent().append(about)
                    $(el).replaceWith(newDiv);
                    var quill = new Quill('#' + el.attr('id'), {
                        modules: {
                            imageResize: {
                                displaySize: true
                            },
                            toolbar: [
                                // Extended toolbar buttons
                                //['contain'],
                                [{ 'table': tableOptions }], // new table (cursor needs to be out of table)
                                [{ 'table': 'append-row' }], // cursor needs to be in the table
                                [{ 'table': 'append-col' }], // cursor needs to be in the table
                                [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                                [{ 'font': [] }],
                                [{ 'align': [] }],
                                ['bold', 'italic', 'underline', 'strike'],        // toggled buttons
                                [{ 'color': [] }, { 'background': [] }],          // dropdown with defaults from theme
                                ['link', 'image'],

                                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                                [{ 'script': 'sub' }, { 'script': 'super' }],      // superscript/subscript
                                [{ 'indent': '-1' }, { 'indent': '+1' }],          // outdent/indent
                                [{ 'direction': 'rtl' }],                         // text direction

                            ]
                        },
                        theme: 'snow'
                    });

                    if (form && form.length > 0) {

                        form.on('submit', function (e) {
                            // Populate hidden form on submit
                            var html = quill.container.firstChild.innerHTML;
                            about.val(html);

                        });

                    }
                });
            </script>
        }

