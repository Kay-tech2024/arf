@{

    var preferences = CommonManager.GetUserPreferences();
    var controller = HttpContextManager.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLower();
    var action = HttpContextManager.Current.Request.RequestContext.RouteData.Values["action"].ToString().ToLower();

    if (preferences.Menu == MenuPreference.DontCare)
    {
        preferences.Menu = MenuPreference.Expanded;
    }
}
<!DOCTYPE html>
<html lang="lang_code">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@LangHelpers.Instance["system_title"] - @ViewBag.Title</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    @if (preferences.Language == LanguagePreference.Arabic)
    {

        @Styles.Render("~/Content/css/admin_css_rtl")
    }
    else
    {
        @Styles.Render("~/Content/css/admin_css")
    }

    @if (ARF.Core.Constants.EnableChatting)
    {
        @Styles.Render("~/Content/css/chat")
    }

    @if (ViewBag.FileUploadRequired == true)
    {
        <link rel="stylesheet" type="text/css" href="~/Content/css/jquery.fileupload.css">
        <link rel="stylesheet" type="text/css" href="~/Content/css/jquery.fileupload-ui.css">
    }
    <link rel="stylesheet" type="text/css" href="~/Content/css/main.css">
    <link rel="apple-touch-icon-precomposed" sizes="57x57" href="~/Content/img/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="~/Content/img/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="~/Content/img/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="~/Content/img/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon-precomposed" sizes="60x60" href="~/Content/img/apple-touch-icon-60x60.png" />
    <link rel="apple-touch-icon-precomposed" sizes="120x120" href="~/Content/img/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon-precomposed" sizes="76x76" href="~/Content/img/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon-precomposed" sizes="152x152" href="~/Content/img/apple-touch-icon-152x152.png" />
    <link rel="icon" type="image/png" href="~/Content/img/favicon-196x196.png" sizes="196x196" />
    <link rel="icon" type="image/png" href="~/Content/img/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="~/Content/img/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="~/Content/img/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="~/Content/img/favicon-128.png" sizes="128x128" />
    <meta name="application-name" content="&nbsp;" />
    <meta name="msapplication-TileColor" content="#FFFFFF" />
    <meta name="msapplication-TileImage" content="@(Utils.GetApplicationUrl())Content/img/mstile-144x144.png" />
    <meta name="msapplication-square70x70logo" content="@(Utils.GetApplicationUrl())Content/img/mstile-70x70.png" />
    <meta name="msapplication-square150x150logo" content="@(Utils.GetApplicationUrl())Content/img/mstile-150x150.png" />
    <meta name="msapplication-wide310x150logo" content="@(Utils.GetApplicationUrl())Content/img/mstile-310x150.png" />
    <meta name="msapplication-square310x310logo" content="@(Utils.GetApplicationUrl())Content/img/mstile-310x310.png" />
    <script src="~/Content/js/jquery.js" nonce="@Html.ScriptNonce()"></script>
    @if (preferences.Language == LanguagePreference.English)
    {
        <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet">

    }

    <script type="text/javascript" nonce="@Html.ScriptNonce()">
        var lang = '@(preferences.Language == LanguagePreference.Arabic ? "ar" : "en")';
        var baseUrl = '@Utils.GetApplicationUrl()';
        var baseAjaxUrl = '@Utils.GetApplicationUrl()ajax/';

        var username = '@Utils.UserUtils.CurrentUser.UserName';
        var currUserId = '@Utils.UserUtils.CurrentUser.Id';

    </script>

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <!--[if lte IE 9]>
        <link href="@Url.Content("~/Content/css/placeholder_polyfill.min.css")" rel="stylesheet" />
    <![endif]-->
</head>
<body class="@controller" dir="rtl">
    @if (Utils.TimeMachineEffective)
    {
        <a href="~/TimeMachine" target="_blank" id="timeMachineTime" style="position: absolute;top: 0;right: 0px;background: red;z-index: 99999999;padding: 1px;color: #fff;width: 240px;text-align: center;">
            الوقت الحالي: @TM.Now.FormatDate(true, false)
        </a>

    }

    <a id="burger" style="font-size: 25px; cursor: pointer;" onclick="openNav()"><i class="fa fa-bars"></i></a>
    <a id="menuToggleLang" href="@(Utils.GetLocalizedFullUrl(preferences.Language != LanguagePreference.Arabic ? "ar" : "en"))" title="@(preferences.Language != LanguagePreference.Arabic ? "العربية" : "English")" class="btn btn-icon btn-xs btn-info">@(preferences.Language != LanguagePreference.Arabic ? "العربية" : "English")</a>
    <div id="sideMenu">
        @*<div id="sideMenuFixed"></div>*@
        <div id="sidecontent">
            <div class="logo">
                <img src="~/Content/aps/imgs/logo-1.png" class="img-responsive center-block" />
            </div>
            @{
                var name = "";
                var roleKey = Utils.GetUserRoles().Count() > 0 ? Utils.GetUserRoles().First().ToString() : "-";
                var roleName = LangHelpers.Instance[roleKey];
                var roleTip = "";
                var collegeName = "";

                if (Utils.CommonUtils.Roles != null && Utils.CommonUtils.Roles.Length > 0)
                {
                    if (Utils.IsCollegeUser)
                    {
                        var College = Utils.CommonUtils.DbContext.Colleges.Where(p => p.Id == Utils.CommonUtils.CurrentUser.CollegeId).FirstOrDefault();
                        if (College.RoleGroupCode != 0 && Utils.HasRolesAny(ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch))
                        {
                            roleName = WebUtils.GetViceDeanForHigherStudiesAndScientificResearchSubRoleName(College.RoleGroupCode.Value, roleKey, College.ResearchUnitCode.Value);
                        }
                        collegeName = preferences.Language == LanguagePreference.Arabic ? College.NameArabic : College.NameEnglish;
                    }
                    name = Utils.GetCurrentUserDetails().FullName;
                    roleTip = LangHelpers.Instance.GetLangValueByString("role") + ": " + roleName;

                }

                if (!string.IsNullOrWhiteSpace(collegeName))
                {
                    roleTip += ", " + LangHelpers.Instance.GetLangValueByString("college") + ": " + collegeName;
                }

            }

            <br />
            <p class="text-center">
                <a class="profile-link" href="~/Account/Profile"><em>@name</em></a>
            </p>

            <p class="text-center"><b>@roleName</b></p>

            @{
                var roles = Utils.UserUtils.GetDelegations();
                if (roles.Count > 0)
                {
                    <div style="max-width: 160px; margin: 0 auto">
                        <select id="selectChannel" class="no-selectpicker form-control" style="color: #000 !important;">
                            @{
                                string _displayName = LangHelpers.Instance[Utils.GetActualUserRole().ToString()];
                                if (Utils.GetActualUserRole().ToString() == ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch.ToString())
                                {
                                    if (Utils.IsCollegeUser)
                                    {
                                        var UserCollege = Utils.CommonUtils.DbContext.Colleges.Where(p => p.Id == Utils.CommonUtils.CurrentUser.CollegeId).FirstOrDefault();

                                        if (UserCollege != null)
                                        {
                                            _displayName = WebUtils.GetViceDeanForHigherStudiesAndScientificResearchSubRoleName(Convert.ToInt32(UserCollege.RoleGroupCode), Utils.GetActualUserRole().ToString(), Convert.ToInt32(UserCollege.ResearchUnitCode));
                                        }
                                    }
                                }

                            }
                            <option @(!Utils.UserUtils.IsImpersonating ? "selected" : "") value="@Utils.GetActualUserRole()">@_displayName</option>
                            @foreach (var d in roles)
                            {
                                _displayName = LangHelpers.Instance[d.Key.ToString()];
                                if (d.Key.ToString() == ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch.ToString() && d.Value != null)
                                {
                                    var college = Utils.GetCollegeDetails(d.Value.Value);
                                    if (college != null)
                                    {
                                        _displayName = WebUtils.GetViceDeanForHigherStudiesAndScientificResearchSubRoleName(Convert.ToInt32(college.RoleGroupCode), d.Key.ToString(), Convert.ToInt32(college.ResearchUnitCode));
                                    }
                                }
                                <option @(Utils.HasRolesAny(d.Key) && (Utils.CurrentUser.CollegeId == d.Value || d.Value == null) ? "selected" : "") value="@d.Key.ToString()" data-college="@d.Value">@_displayName</option>
                            }
                        </select>
                    </div>

                    <br />

                    this.ScriptBlock(

    @<script type="text/javascript" nonce="@Html.ScriptNonce()">

         $('#selectChannel').change(function () {
             var value = $(this).val();
             var college = $(this).find('option:selected').attr('data-college');

             if (college === 'null') college = null;

             if (!value || value === '') return;

             if (college == null)
                 window.location.href = baseUrl + 'Home/ChangeUserRole?role=' + value;
             else
                 window.location.href = baseUrl + 'Home/ChangeUserRole?role=' + value + '&collegeId=' + college;
         });
    </script>
);

                }
            }

            <ul class="menu">
                <li @Html.Raw(controller == "home" ? "class=\"active\"" : "")>
                    <a href="@Url.Action("Index", "Home")">
                        <span>@LangHelpers.Instance["homepage"]</span>
                    </a>
                </li>
            </ul>

            @if (Utils.HasRolesAny(ArfUserRole.PrincipalResearcher))
            {
                <ul class="menu">
                    <li @Html.Raw(controller == "home" ? "class=\"\"" : "")>
                        <a href="@Url.Action("Create", "Requests")">
                            <span>@LangHelpers.Instance["new_funding_request"]</span>
                        </a>
                    </li>
                </ul>

                <ul class="menu">
                    <li @Html.Raw(controller == "home" ? "class=\"\"" : "")>
                        <a href="@Url.Action("FundingRequests", "Requests")">
                            <span>@LangHelpers.Instance["FollowUpOfFundingRequests"]</span>
                        </a>
                    </li>
                </ul>

            }
            else if (Utils.HasRolesAny(ArfUserRole.DeanofDeanshipofScientificResearch))
            {
                <ul class="menu">
                    <li @Html.Raw(controller == "home" ? "class=\"\"" : "")>
                        <a href="@Url.Action("Index", "Announcements")">
                            <span>@LangHelpers.Instance["AnnouncementsOfFundingCycles"]</span>
                        </a>
                    </li>
                </ul>
            }

            @if (Utils.HasRolesAny(ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch, ArfUserRole.SecretaryOfTheStandingCommitteeForFinancingResearchProjects))
            {
                <ul title="@LangHelpers.Instance["council_members"]" class="menu">
                    <li @Html.Raw(controller == "members" ? "class=\"active has-sub-menu\"" : "")>
                        <a href="@Url.Action("index", "members")">
                            <span>@LangHelpers.Instance["council_members"]</span>
                        </a>
                    </li>

                    @if (controller == "members")
                    {

                        <li class="sub-menu-item @Html.Raw(controller == "members" && action == "create" ? "active" : "")"><a href="@Url.Action("Create", "members")"><span>@LangHelpers.Instance["create_new"]</span></a></li>
                        if (controller == "members" && action == "edit")
                        {
                            <li class="sub-menu-item active"><a href="#"><span>@LangHelpers.Instance["edit"]</span></a></li>
                        }

                    }
                </ul>
            }

            @if (Utils.HasPrivilagesAny(Privilages.settings_templates))
            {
                <ul title="@LangHelpers.Instance["templates"]" class="menu">
                    <li @Html.Raw(controller == "templates" ? "class=\"active has-sub-menu\"" : "")>
                        <a href="@Url.Action("index", "templates")">
                            <span>@LangHelpers.Instance["templates"]</span>
                        </a>
                    </li>

                    @if (controller == "templates")
                    {

                        if (controller == "templates" && action == "edit")
                        {
                            <li class="sub-menu-item active"><a href="#"><span>@LangHelpers.Instance["edit"]</span></a></li>
                        }

                    }
                </ul>
            }

            @if (Utils.HasRolesAny(ArfUserRole.SystemAdmin, ArfUserRole.DirectorOfTheProgramOfFinancingResearchProjectsAndTeachingStaffMembers))
            {
                <ul title="@LangHelpers.Instance["settings"]" class="menu">
                    <li @Html.Raw(controller == "settings" ? "class=\"active\"" : "")>
                        <a href="@Url.Action("Contract", "settings")">
                            <span>@LangHelpers.Instance["settings"]</span>
                        </a>
                    </li>
                </ul>
            }


            @if (Utils.HasRolesAny(ArfUserRole.SystemAdmin, ArfUserRole.SecretaryOfTheStandingCommitteeForFinancingResearchProjects))
            {
                <ul title="@LangHelpers.Instance["referees"]" class="menu">
                    <li @Html.Raw(controller == "referees" ? "class=\"active has-sub-menu\"" : "")>
                        <a href="@Url.Action("index", "referees")">
                            <span>@LangHelpers.Instance["referees"]</span>
                        </a>
                    </li>

                    @if (controller == "referees")
                    {

                        <li class="sub-menu-item @Html.Raw(controller == "referees" && action == "create" ? "active" : "")"><a href="@Url.Action("Create", "referees")"><span>@LangHelpers.Instance["create_new"]</span></a></li>
                        if (controller == "referees" && action == "edit")
                        {
                            <li class="sub-menu-item active"><a href="#"><span>@LangHelpers.Instance["edit"]</span></a></li>
                        }

                    }
                </ul>
            }

            @if (Utils.HasPrivilagesAny(AccessPrivilagesMatrix.ModuleUsers))
            {
                <ul title="@LangHelpers.Instance["researchers"]" class="menu">
                    <li @Html.Raw(controller == "researchers" ? "class=\"active has-sub-menu\"" : "")>
                        <a href="@Url.Action("index", "researchers")">
                            <span>@LangHelpers.Instance["researchers"]</span>
                        </a>
                    </li>

                    @if (controller == "researchers")
                    {

                        <li class="sub-menu-item @Html.Raw(controller == "researchers" && action == "create" ? "active" : "")"><a href="@Url.Action("Create", "researchers")"><span>@LangHelpers.Instance["create_new"]</span></a></li>
                        if (controller == "researchers" && action == "edit")
                        {
                            <li class="sub-menu-item active"><a href="#"><span>@LangHelpers.Instance["edit"]</span></a></li>
                        }

                    }
                </ul>

            }

            @if (Utils.HasPrivilagesAny(AccessPrivilagesMatrix.ModuleUsers))
            {
                <ul title="@LangHelpers.Instance["users"]" class="menu">
                    <li @Html.Raw(controller == "users" ? "class=\"active has-sub-menu\"" : "")>
                        <a href="@Url.Action("Index", "Users")">
                            <span>@LangHelpers.Instance["users"]</span>
                        </a>
                    </li>

                    @if (controller == "users")
                    {

                        <li class="sub-menu-item @Html.Raw(controller == "users" && action == "create" ? "active" : "")"><a href="@Url.Action("Create", "Users")"><span>@LangHelpers.Instance["create_new"]</span></a></li>
                        if (controller == "users" && action == "edit")
                        {
                            <li class="sub-menu-item active"><a href="#"><span>@LangHelpers.Instance["edit"]</span></a></li>
                        }

                    }
                </ul>
            }

            @if (!Utils.UserUtils.IsImpersonating)
            {
                <ul title="profile" class="menu">
                    <li @Html.Raw(controller == "account" ? "class=\"active has-sub-menu\"" : "") i>
                        <a href="@Url.Action("Profile", "Account")">
                            <span>@LangHelpers.Instance["profile"]</span>
                        </a>
                    </li>
                </ul>
            }

            @if (Utils.HasRolesAny(ArfUserRole.DeanofDeanshipofScientificResearch, ArfUserRole.SystemAdmin))
            {
                <ul title="@LangHelpers.Instance["reports"]" class="menu">
                    <li @Html.Raw(controller == "reports" ? "class=\"active has-sub-menu\"" : "") i>
                        <a href="@Url.Action("Index", "Reports")">
                            <span>@LangHelpers.Instance["reports"]</span>
                        </a>
                    </li>
                    <li class="sub-menu-item " i>
                        <a href="@Url.Action("Types", "Reports")">
                            <span>@LangHelpers.Instance["requests_report"]</span>
                        </a>
                    </li>
                    <li class="sub-menu-item " i>
                        <a href="@Url.Action("Financial", "Reports")">
                            <span>@LangHelpers.Instance["financial_report"]</span>
                        </a>
                    </li>
                    <li class="sub-menu-item " i>
                        <a href="@Url.Action("FinancialResearchTeam", "Reports")">
                            <span>@LangHelpers.Instance["research_team_financial_report"]</span>
                        </a>
                    </li>
                    <li class="sub-menu-item " i>
                        <a href="@Url.Action("Materials", "Reports")">
                            <span>@LangHelpers.Instance["materials_and_equipment_report"]</span>
                        </a>
                    </li>
                </ul>
            }

            @if (Utils.HasRolesAny(ArfUserRole.PrincipalResearcher) || Utils.HasRolesAny(ArfUserRole.ViceDeanForHigherStudiesAndScientificResearch) || Utils.HasRolesAny(ArfUserRole.MembersOfTheStandingCommitteeForFinancingResearchProjects) || Utils.HasRolesAny(ArfUserRole.SecretaryOfTheStandingCommitteeForFinancingResearchProjects))
            {
                <ul title="@ArfStrings.user_guide" class="menu">
                    <li>
                        <a href="@Url.Action("UserGuide", "About")" target="_blank">
                            <span>@ArfStrings.user_guide</span>
                        </a>
                    </li>
                </ul>
            }

            @if (!Utils.HasRolesAny(ArfUserRole.SystemAdmin))
            {
                <ul title="@ArfStrings.technical_support" class="menu">
                    <li>
                        <a href="@Url.Action("ContactUs", "About")">
                            <span>@ArfStrings.technical_support</span>
                        </a>
                    </li>
                </ul>
            }
            else
            {

                <ul title="@ArfStrings.contactus" class="menu">
                    <li>
                        <a href="@Url.Action("index", "ContactedMessages")">
                            <span>@ArfStrings.inbox</span>
                        </a>
                    </li>
                </ul>
            }
            <ul title="sign_out" class="menu">
                <li>
                    <a href="@Url.Action("LogOff", "Account")">
                        <span>@LangHelpers.Instance["sign_out"]</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
    @this.ScriptBlock(
                                                                                                    @<script>
                                                                                                         $("#opener").click(function () {
                                                                                                             $('#myModal').modal('toggle');
                                                                                                         });

                                                                                                         $("#buttonImpersonate").click(function () {
                                                                                                             $('#impersonationModal').modal('toggle');
                                                                                                         });
                                                                                                         $(window).on('resize', function () {
                                                                                                             var win = $(this); //this = window

                                                                                                             if ((win.width() <= 960)) {
                                                                                                                 //$('body').addClass('minimenu');
                                                                                                                 $('#fa').removeClass('fa-arrow-circle-left').addClass('fa-arrow-circle-right');
                                                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                                                             }
                                                                                                             if ((win.width() > 740)) {
                                                                                                                 //$('body').addClass('minimenu');
                                                                                                                 $('#fa').removeClass('fa-arrow-circle-left').addClass('fa-arrow-circle-right');
                                                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                                                                 $('#sidecontent').removeAttr("style");
                                                                                                             }
                                                                                                             if ((win.width() > 960)) {
                                                                                                                 $('body').removeClass('minimenu');
                                                                                                                 $('#fa').removeClass('fa-arrow-circle-right').addClass('fa-arrow-circle-left');
                                                                                                                 $('#menuToggle').attr('title', 'Expand Menu');
                                                                                                             }
                                                                                                         });

                                                                                                         $('#burger').click(function (e) {
                                                                                                             e.stopPropagation();
                                                                                                             openNav();
                                                                                                         });
                                                                                                         $('#sidecontent').click(function (e) {
                                                                                                             e.stopPropagation();
                                                                                                         });
                                                                                                         $('body,html').click(function (e) {
                                                                                                             var win = $(this);
                                                                                                             if (win.width() <= 740) {
                                                                                                                 closeNav();
                                                                                                             }
                                                                                                         });
                                                                                                    </script>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         )

    <script nonce="@Html.ScriptNonce()">
        function openNav() {
            document.getElementById("sidecontent").style.display = "block";
            document.getElementById("sidecontent").style.width = "250px";
        }

        function closeNav() {
            document.getElementById("sidecontent").style.width = "0";
        }
    </script>

    <!-- /.control-sidebar-menu -->
    <!-- Content Wrapper. Contains page content -->

    <div id="content" class="container-fluid" style="padding-left:25px;padding-right:45px;">

        <div id="spinloader" class="loader"></div>

        @{
            var ann = Utils.GetActiveAnnouncement();

            if (ann != null)
            {
                <div class="alert alert-info">@LangHelpers.Instance["warning_current_announcement"] <span class="ltr">@ann.EndDateGreg.FormatHijriDate()</span></div>
            }
        }

        @{
            var message = (string)null;
            var message_type = (string)null;
            var message_link = (string)null;

            if (!string.IsNullOrWhiteSpace(ViewBag.Message))
            {
                message = ViewBag.Message;
                message_type = ViewBag.MessageType;
                message_link = ViewBag.MessageLink;
            }
            else if (TempData["message"] != null && !string.IsNullOrWhiteSpace((string)TempData["message"]))
            {
                message = (string)TempData["message"];
                message_type = (string)TempData["message_type"];
                message_link = (string)TempData["message_link"];
            }

            if (!string.IsNullOrWhiteSpace(message))
            {

                if (string.IsNullOrWhiteSpace(message_type))
                {
                    message_type = "success";
                }

                if (!string.IsNullOrWhiteSpace(message_link))
                {
                    message = message.Replace("<link>", "<a href=\"" + message_link + "\">").Replace("</link>", "</a>");
                }

                this.ScriptBlock(
@<script type="text/javascript" nonce="@Html.ScriptNonce()">

                        notify('@Html.Raw(message.Replace("'", "\\'").Replace("\r\n", "<br />"))', '@message_type');
</script>
);
            }

        }

        <div class="col-md-12">
            <div class="alert alert-danger" style="display:none;">
                <h3>@LangHelpers.Instance["PleaseMakeSureOf"]</h3>
                <ul id="valdmsg" class="validationul"></ul>
            </div>
        </div>

        @RenderBody()

        @if (ARF.Core.Constants.EnableChatting)
        {
            <input type="hidden" id="connId" />

            <a class="toggle-chat btn btn-xs btn-primary" style=""><span></span>Chat</a>

            <div class="wrapper-chat">
                <div class="container container-chat">
                    <div class="left">
                        <div class="top">
                            <input type="text" />
                            <a href="javascript:;" class="search"></a>
                        </div>
                        <ul class="people"></ul>
                    </div>
                    <div class="right">
                        <div class="top"><span class="name"></span></div>
                        <div id="discussion" class="messages-list" style="overflow:auto"></div>
                        <div class="write">
                            <a href="javascript:;" class="write-link attach"></a>
                            <input id="message" type="text" />
                            <a href="javascript:;" class="write-link smiley"></a>
                            <a id="sendmessage" href="javascript:;" class="write-link send"></a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @Scripts.Render("~/Content/js/admin_js")

        @if (ARF.Core.Constants.EnableChatting)
        {
            @Scripts.Render("~/Content/js/chat")
            <script src="~/signalr/hubs" nonce="@Html.ScriptNonce()"></script>

