            }());

            var AreYouSure = function (e) {
                if (confirm('are_you_sure')) {
                    return true;
                }
                e.preventDefault();
                return false;
            };

            //$('select').selectpicker({
            //    liveSearch: true,
            //    noneResultsText: 'No results for {0}'
            //});

            var toggleMenu = function () {
                if ($('body').hasClass('minimenu'))
                    $('body').removeClass('minimenu');
                else
                    $('body').addClass('minimenu');
            };

            $('#menuToggle').click(function () {
                toggleMenu();

                if ($('body').hasClass('minimenu')) {
                    $('#menuToggle').attr('title', 'Expand menu').find('.fa')
                        .attr('class', 'fa fa-arrow-circle-@(preferences.Language != LanguagePreference.Arabic ? "right" : "left")');
                } else {
                    $('#menuToggle').attr('title', 'Collapse menu').find('.fa')
                        .attr('class',
                        'fa fa-arrow-circle-@(preferences.Language != LanguagePreference.Arabic || (preferences.Menu == MenuPreference.Expanded && preferences.Language == LanguagePreference.Arabic) ? "left" : "right")');
                }

                saveMenuPosition($('body').hasClass('minimenu') ? 'collapsed' : 'expanded');

            });

            $('#menuTogglePin').click(function () {
                if ($(this).hasClass('active')) {
                    saveMenuPosition('dontcare');
                    $(this).removeClass('active');
                } else {
                    saveMenuPosition($('body').hasClass('minimenu') ? 'collapsed' : 'expanded');
                    $(this).addClass('active');
                }
            });

            var saveMenuPosition = function (value) {
                $.ajax(baseAjaxUrl + "SavePreference",
                    {
                        type: 'post',
                        cache: false,
                        data: { key: 'menu', value: value }
                    });
            };

            window.tab2 = function (e) {

                var $target = $(e);
                var $tabs = $target.closest('.nav-tabs-responsive');
                var $current = $target.closest('li');
                var $parent = $current.closest('li.dropdown');
                $current = $parent.length > 0 ? $parent : $current;
                var $next = $current.next();
                var $prev = $current.prev();
                var updateDropdownMenu = function ($el, position) {
                    $el
                        .find('.dropdown-menu')
                        .removeClass('pull-xs-left pull-xs-center pull-xs-right')
                        .addClass('pull-xs-' + position);
                };

                $tabs.find('>li').removeClass('next prev');
                $prev.addClass('prev');
                $next.addClass('next');

                updateDropdownMenu($prev, 'left');
                updateDropdownMenu($current, 'center');
                updateDropdownMenu($next, 'right');
            }

            $(document).on('show.bs.tab',
                '.nav-tabs-responsive [data-toggle="tab"]',
                function (e) {
                    tab2(e.target);
                });

            tab2($('.nav-tabs li.active a'));

            $.ajaxSetup({ cache: false });
        </script>

