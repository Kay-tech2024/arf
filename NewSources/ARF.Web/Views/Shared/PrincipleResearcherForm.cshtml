@{
    ARF.Data.DbModels.ArfDbEntities db = new ARF.Data.DbModels.ArfDbEntities();
    var preferences = CommonManager.GetUserPreferences();
    var isArabic = preferences == null || preferences.Language != LanguagePreference.English;
}
@model ARF.Web.Models.FundingRequestViewModel

<div class="form-group" style="border:1px solid #333; padding:10px; display:none">
    <label class="control-label col-md-4">
        @LangHelpers.Instance["ProjectSeries"]
    </label>
    <label class="control-label col-md-4">
        @LangHelpers.Instance["ResearchUnitCode"]
    </label>
    <label class="control-label col-md-4">
        @LangHelpers.Instance["Year"]
    </label>
    <div class="col-md-4">
        @Html.TextBoxFor(m => m.Request.Serial, new { @class = "form-control" })
    </div>
    <div class="col-md-4">
        @Html.TextBoxFor(m => m.Request.Code, new { @class = "form-control" })
    </div>
    <div class="col-md-4">
        @Html.TextBoxFor(m => m.Request.StartDate, new { @class = "form-control" })
    </div>
</div>
<div class="form-group" style="border:1px solid #333; padding:10px;">
    <div class="form-group">
        <label class="control-label col-md-3">
            @LangHelpers.Instance["ArabicTitleOfProposedProject"]
        </label>
        <div class="col-md-9">
            @Html.TextBoxFor(m => m.Request.Title, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-3">
            الميزانية المقترحة
        </label>
        <div class="col-md-3">
            <div class="input-group">
                @Html.TextBoxFor(m => m.Request.AmountSar, new { @class = "form-control", @type = "number" })
                <span class="input-group-addon">
                    ريال
                </span>
            </div>
        </div>
        <label class="control-label col-md-3">
            المدة المقترحة
        </label>
        <div class="col-md-3">
            <div class="input-group">
                @Html.TextBoxFor(m => m.Request.Duration, new { @class = "form-control", @type = "number" })
                <span class="input-group-addon">
                    @LangHelpers.Instance["Month"]
                </span>
            </div>
        </div>
    </div>

</div>
<div class="form-group" style="border:1px solid #333; padding:10px; display:none;">
    <label class="control-label col-md-3">
        @LangHelpers.Instance["SearchProjectType"]
    </label>
    <div class="col-md-9">
        <div class="radio-inline">
            <label>
                @Html.RadioButtonFor(m => m.Request.PublicationType, 1) @LangHelpers.Instance["Single"]
            </label>
        </div>
        <div class="radio-inline">
            <label>
                @Html.RadioButtonFor(m => m.Request.PublicationType, 2) @LangHelpers.Instance["Joint"]
            </label>
        </div>
    </div>
</div>
<div id="dresearchers">
    <div class="form-group" id="researchers" style="border:1px solid #333; padding:10px;">

        @{
            var index = 0;

            if (Model.Researchers == null || Model.Researchers.Count == 0)
            {
                Model.Researchers = new List<ResearcherViewModel>() { new ResearcherViewModel { } };
            }

            foreach (var r in Model.Researchers)
            {
                ViewBag.index = index;
                <div id="main-researcher">
                    @Html.Partial("_ResearchersPartial", Model);
                    <div class="col-md-5">
                        <a class="btn btn-primary col-md-3 add-researcher" style="width: auto; padding: 10px;">إضافة باحث مشارك</a>
                    </div>
                </div>
                index++;
            }
        }

    </div>

    <div>
        @Html.HiddenFor(m => m.FieldType)
    </div>

    <div class="form-group">
        <label class="control-label col-md-3">@LangHelpers.Instance["ProjectField"]</label>
        <div class="col-md-9">
            <label class="control-label col-md-3">التخصص العام: </label>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.Request.ResearchFieldGeneral, new { @class = "form-control" })
            </div>
            <label class="control-label col-md-3">التخصص الدقيق: </label>
            <div class="col-md-3">
                @Html.TextBoxFor(m => m.Request.ResearchFieldSpecific, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-12">هل سبق تقديم المقترح لوحدة \مركز البحوث في دورات سابقة؟</label>
        <div class="col-md-12">
            <div class="radio-inline col-md-6">
                <label class="col-md-2">
                    @Html.RadioButtonFor(m => m.Request.HasBeenPresentedBefore, true) @LangHelpers.Instance["yes"]
                </label>
                <div class="col-md-10">
                    <label class="control-label col-md-4">
                        رقم المقترح:
                    </label>
                    <div class="col-md-6">
                        @Html.TextBoxFor(m => m.Request.ResearcherPresentaionNumber, new { @class = "form-control" })
                    </div>
                </div>

            </div>
            <div class="radio-inline col-md-5">
                <label class="col-md-4">
                    @Html.RadioButtonFor(m => m.Request.HasBeenPresentedBefore, false) @LangHelpers.Instance["No"]
                </label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-6">عدد البحوث الممولة سابقا للباحث الرئيس من عمادة البحث العلمي</label>
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.Request.NumberOfPerviousFundedResearchs, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <label class="col-md-6">عدد الاوراق البحثة اللتي ستنتشر من المشروع</label>
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.Request.NumberOfResearchCommingPapers, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-5">
            الكلمات الدالة عي البحث keywords (من 6 إلى 10 كلمات)
        </label>
        <div class="col-md-5">
            @Html.TextAreaFor(m => m.Request.KeyWords, new { @class = "form-control", rows = 5 })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-9">
            هــل ينــدرج المشــروع البحثــي للتمويــل ضمــن أولويــات البحــث العلمــي للقســم العلمــي الــذي تعمــل ؟
        </label>
        <div class="col-md-3">
            <div class="radio-inline col-md-5">
                <label class="col-md-4">
                    @Html.RadioButtonFor(m => m.Request.HasPriority, true) @LangHelpers.Instance["yes"]
                </label>
            </div>
            <div class="radio-inline col-md-5">
                <label class="col-md-4">
                    @Html.RadioButtonFor(m => m.Request.HasPriority, false) @LangHelpers.Instance["No"]
                </label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-12">اذا كانت الاجابة نعم فما هي تلك الاولوية:</label>
        <label class="control-label col-md-3">رقم الاولوية:</label>
        <div class="col-md-1">
            @Html.TextBoxFor(m => m.Request.PriorityNumber, new { @class = "form-control", @type = "number" })
        </div>
        <label class="control-label col-md-3">وتنص علي:</label>
        <br /><br /><br /><br />
        <div class="col-md-12">
            @Html.TextAreaFor(m => m.Request.PriortyDescription, new { @class = "form-control", rows = 5 })
        </div>
    </div>

    @{
        if (Model.FieldType == ReqFieldType.AppliedScienceField)
        {
            <div class="ltr div_en" style="font-size:17px; font-family:Calibri">
                <p>Complete below in full. Do not modify/remove sections – if not applicable to you please indicate “n/a”.</p>

                <div class="form-horizontal">
                    <h4>Research Project Title</h4>
                    <div>
                        <div class="radio">
                            <label><input type="radio" name="optradio">Medical (• Clinical • BioMedical)</label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" name="optradio">Science</label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" name="optradio">Engineering</label>
                        </div>
                        <div class="radio">
                            <label><input type="radio" name="optradio">Computing</label>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="form-horizontal">
                    <h4>Principal Investigator/Applicant</h4>
                    <div class="form-group">
                        <label class="control-label">Full Name</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Academic Appointment</label>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Dept/College" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Title" />
                        </div>

                    </div>
                    <div class="form-group">
                        <label class="control-label">Contact Information</label>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Telephone" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Email" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Address</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" placeholder="Street Address and Suite/Unit" />
                        </div>
                        <div class="col-md-4">&nbsp;</div>

                        <div class="col-md-8" style="padding:0">
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="Postal Code" /></div>
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="Province" /></div>
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="City/Town" /></div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="form-horizontal">
                    <h4>Funding Requested (maximum per year for up to two years)</h4>
                    <div class="form-group">
                        <label class="control-label">Year One</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Year Two</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Total Amount Requested</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Duration of Project (max two years)</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Project Start Date</label>
                        <div class="col-md-8">
                            <input class="form-control" type="date" />
                        </div>
                    </div>
                </div>

                <hr />

                <div class="form-horizontal">
                    <h4>Co - Principal Investigator Information</h4>

                    <div class="form-group">
                        <label class="control-label">Full Name</label>
                        <div class="col-md-8">
                            <input class="form-control" type="text" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Project Role of Co-PI</label>
                        <div class="col-md-8">
                            <label class="radio-inline">
                                <input type="radio" name="optradio">Supervisor
                            </label>
                            <label class="radio-inline">
                                <input type="radio" name="optradio">Peer
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Clinical or Tech Appointment</label>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Title" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Institution" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Academic Appointment</label>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Title" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Institution" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Contact Information</label>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Telephone" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" type="text" placeholder="Email" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Address</label>

                        <div class="col-md-8">
                            <input class="form-control" type="text" placeholder="Street Address and Suite/Unit" />
                        </div>

                        <div class="col-md-4">&nbsp;</div>

                        <div class="col-md-8" style="padding:0">
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="Postal Code" /></div>
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="Province" /></div>
                            <div class="col-md-4"><input class="form-control" type="text" placeholder="City/Town" /></div>
                        </div>
                    </div>

                </div>

                <hr />

                <div class="form-horizontal maximum-width">
                    <h4>Co-Investigators (maximum of three co-investigators) - CVs are required</h4>

                    <table class="table table-responsive table striped co-investigators">
                        <thead>
                            <tr>
                                <th>
                                    Full Name
                                </th>
                                <th>
                                    Title and Institution (Clinical / Academic appointment)
                                </th>
                                <th>
                                    Project Role / Expertise
                                </th>
                                <th>
                                    CV
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="file" class="form-control" />
                                </td>
                            </tr>

                        </tbody>
                    </table>

                    <a class="btn btn-primary btn xs add-row">Add Row</a>

                </div>
                <hr />

                <div class="form-horizontal maximum-width">
                    <h4>Collaborators (add rows as needed to list all collaborators) - CVs are not required; Letters of support are required</h4>

                    <table class="table table-responsive table striped">
                        <thead>
                            <tr>
                                <th>
                                    Full Name
                                </th>
                                <th>
                                    Title and Institution (Clinical / Academic appointment)
                                </th>
                                <th>
                                    Project Role / Expertise
                                </th>
                                <th>
                                    CV
                                </th>
                                <th>
                                    Letter of Support
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="file" class="form-control" />
                                </td>
                                <td>
                                    <input type="file" class="form-control" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <a class="btn btn-primary btn xs add-row">Add Row</a>

                </div>

                <hr />

                <h4>Lay Summary Description of Project (max 200 words)</h4>
                <label>Describe objectives and methodology in plain language. If funded, this description will be used to describe you project in communications.</label>
                <div class="form-horizontal maximum-width">
                    <div class="form-group">
                        <div class="col-md-12">
                            <textarea class="form-control" type="text" rows="5"></textarea>
                        </div>
                    </div>
                </div>
                <hr />
                <h4>Other Funding</h4>
                <label>Results of funding from other sources may affect your approved budget, therefore please notify the deanship of scientific research immediately if you have receieved other funding. Have you applied / intending to apply for other funding for this study?</label>

                <div class="form-horizontal">
                    <div class="form-group">
                        <div class="col-md-8">
                            <label class="radio-inline">
                                <input type="radio" name="optradio">Yes
                            </label>
                            <label class="radio-inline">
                                <input type="radio" name="optradio">No
                            </label>
                        </div>
                    </div>
                </div>
                <div>
                    <label> If yes, complete the table below and add rows as necessary</label>
                    <table class="table table responsive table-striped">
                        <thead>
                            <tr>
                                <th>
                                    Funding Agency
                                </th>
                                <th>
                                    Amount Requested / Duration
                                </th>
                                <th>
                                    Status
                                </th>
                                <th>
                                    Date of Expected Pending Descision
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <input type="text" class="form-control" />
                                </td>
                                <td>
                                    <div class="text-center">
                                        <label class="radio-inline">
                                            <input type="radio" name="optradio"> Approved
                                        </label>
                                        <label class="radio-inline">
                                            <input type="radio" name="optradio"> Declined
                                        </label>
                                        <label class="radio-inline">
                                            <input type="radio" name="optradio"> Pending
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <input type="date" class="form-control" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <a class="btn btn-primary btn xs add-row">Add Row</a>
                </div>
                <hr />
                <h4>
                    Suggested External Reviewers
                </h4>
                <label>Complete below in full (all four fields) to suggest individuals who have the appropriate expertise for the foundation to potentially ask to peer review your research grant proposal. Suggested reviewers must not be associated in any way with your project or other research activities, your hospital or academic institution. They also should not be anyone who you trained or recently collaborated with or supervised.</label>
                <div>
                    <table class="table table-responsive table-striped">
                        <thead>
                            <tr>
                                <th>
                                    Suggested Reviewer
                                </th>
                                <th>
                                    Contact Information (all fields required)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="vertical-align:middle">
                                    <div class="col-md-6">
                                        <input class="form-control" type="text" placeholder="Academic Appointment" />
                                    </div>
                                    <div class="col-md-6"><input class="form-control" type="text" placeholder="Name and Title" /></div>
                                </td>
                                <td>
                                    <div class="col-md-12" style="margin-bottom:6px">
                                        <input class="form-control" type="text" placeholder="Street Address/City/Province or State/Country/PostalCode" />
                                    </div>
                                    <div class="col-md-6">
                                        <input class="form-control" type="text" placeholder="Email" />
                                    </div>
                                    <div class="col-md-6">
                                        <input class="form-control" type="text" placeholder="Telephone" />
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <a class="btn btn-primary btn xs add-row">Add Row</a>

                </div>
                <hr />
                <h4>
                    <b>Application Instructions</b>
                </h4>
                <label>
                    Your application must include each of the following sections in the requested order,
                    using the titles and numbering as below. Page numbering is required, starting
                    with the first page of the Application Form as page 1. The content must be single
                    spaced, 12 pt font. Sections 1 through 9 must not exceed page limits where stated.
                    Please read the guidelines before completing the application to ensure your
                    project is eligible for consideration.
                </label>
                <ul>
                    <li>
                        <label>
                            Resubmission Response (5 page maximum):
                        </label><p>
                            If this is a resubmission of
                            a previously declined application to the deanship, provide a letter explaining
                            in detail how the resubmission addresses the comments of the external peer
                            reviewers of the previously declined submission.
                        </p>
                        <p><b>Attach Here: </b><input type="file" class="form-control" /></p>
                        <br />
                    </li>
                    <li>
                        <label>
                            Statement of objectives and specific aims of the project in the form of
                            hypothesis (1 page maximum).

                        </label>
                        <p><b>Attach Here: </b><input type="file" class="form-control" /></p>
                        <br />
                    </li>
                    <li>
                        <label>
                            Statement of Relevance (1/2 page maximum):
                        </label><p>
                            Please highlight the relevance
                            and impact of this proposal on the national level.
                        </p>
                        <p><b>Attach Here: </b><input type="file" class="form-control" /></p>
                        <br />
                    </li>
                    <li>
                        <label>
                            Background, rationale and present state of knowledge (6 pages maximum).
                            List of reference for this section (2 pages maximum).
                        </label>
                        <p><b>Attach Here: </b><input type="file" class="form-control" /></p>
                        <br />
                    </li>
                    <li>
                        <label>
                            Project design, methodology and analysis (8 pages maximum). List of
                            references for this section (1 page maximum).
                        </label>
                        <p><b>Attach Here: </b><input type="file" class="form-control" /></p>
                        <br />
                    </li>
                    <li>
                        <label>
                            Project Budget requested from DSR
                        </label>

                        <p>
                            Please read guidelines to ensure eligible items only are requested. Ineligible items will be removed.
                        </p>
                        <h4>
                            Personnel
                        </h4>
                        <div>
                            <table class="table table-responsive table-striped instructions">
                                <thead>
                                    <tr>
                                        <th>
                                            Personnel
                                        </th>
                                        <th>
                                            Year 1
                                        </th>
                                        <th>
                                            Year 2
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><input type="text" class="form-control" /></td>
                                        <td><input type="text" class="form-control" /></td>
                                        <td><input type="text" class="form-control" /></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center" style="vertical-align:middle">Total Personnel</td>
                                        <td><input type="text" class="form-control" /></td>
                                        <td><input type="text" class="form-control" /></td>
                                    </tr>
                                </tbody>
                            </table>

                            <a class="btn btn-primary btn xs add-row">Add Row</a>

                        </div>
                        <h4>
                            Equipment
                        </h4>

                        <div>
                            <table class="table table-responsive table-striped instructions">
                                <thead>
                                    <tr>
                                        <th>
                                            Epuipment
                                        </th>
                                        <th>
                                            Year 1
                                        </th>
                                        <th>
                                            Year 2
                                        </th>
                                    </tr>
                                </thead>
